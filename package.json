{
  "name": "janosik",
  "version": "0.1.0",
  "description": "Self-hosted Kanban board \u2014 offline-first PWA with drag & drop, calendar and table views, undo/redo, WIP limits and i18n.",
  "license": "MIT",
  "author": "Vitali Toustsik",
  "homepage": "https://github.com/VitalyTolstik/janosik#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitalyTolstik/janosik.git"
  },
  "bugs": {
    "url": "https://github.com/VitalyTolstik/janosik/issues"
  },
  "keywords": [
    "kanban",
    "trello-alternative",
    "self-hosted",
    "offline-first",
    "pwa",
    "react",
    "typescript"
  ],
  "private": true,
  "type": "module",
  "workspaces": [
    "ui",
    "shared",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w ui",
    "build": "npm run build -w ui",
    "build:backend": "npm run build -w backend",
    "preview": "npm run preview -w ui",
    "test": "npm run test -w ui && npm run test -w shared",
    "test:backend": "npm run test -w backend",
    "test:coverage": "npm run test:coverage -w ui && npm run test:coverage -w shared",
    "lint": "npm run lint -w ui && npm run lint -w shared && npm run lint -w backend",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "size": "npm run size -w ui",
    "demo:swarm": "node scripts/demo-board-swarm.mjs",
    "demo:100": "node scripts/demo-board-100.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6"
  }
}
