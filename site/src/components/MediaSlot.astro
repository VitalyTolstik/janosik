---
/**
 * A media-ready frame for the landing page.
 *
 * Every slot reserves a 16:10 frame (the clips render at 1280×800), so a clip
 * drops in with no layout shift. Pass `mp4`/`webm`/`poster` (and the `*Dark`
 * pair) to show a feature clip; without them the slot draws a lightweight,
 * on-brand board mockup.
 *
 * Clips are baked per theme, so both variants are rendered and CSS shows the
 * one matching `data-theme`. They are lazy: `preload="none"` keeps them off the
 * wire until they scroll into view (`BaseLayout` plays the visible one), and
 * the poster is the fallback for `prefers-reduced-motion` and no-JS.
 */
export type MediaVariant =
  "board" | "realtime" | "cards" | "sharing" | "selfhost" | "swarm";

interface Props {
  /** Which mockup to draw when there is no media. */
  variant?: MediaVariant;
  /** Accessible description of what the slot shows. */
  label: string;
  /** Light-theme clip sources, relative to the deploy base. */
  mp4?: string;
  webm?: string;
  /** Light-theme poster — also the reduced-motion / no-JS fallback. */
  poster?: string;
  /** Dark-theme clip sources. */
  mp4Dark?: string;
  webmDark?: string;
  posterDark?: string;
  class?: string;
}

const {
  variant = "board",
  label,
  mp4,
  webm,
  poster,
  mp4Dark,
  webmDark,
  posterDark,
  class: className,
} = Astro.props;

// Swarm mockup data — a board where several agents work at once. Columns hold
// cards tagged with the agent that owns them; one card is mid-flight.
const swarmAgents = ["a", "b", "c", "d"] as const;
const swarmColumns = [2, 3, 2, 1];
---

<figure class:list={["slot", `slot--${variant}`, className]} data-slot="media">
  <div class="slot-frame" role="img" aria-label={label}>
    {mp4 || webm ? (
      <>
        <video
          class="slot-media slot-media--light"
          poster={poster}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          data-lazy-video
        >
          {webm && <source src={webm} type="video/webm" />}
          {mp4 && <source src={mp4} type="video/mp4" />}
        </video>
        <video
          class="slot-media slot-media--dark"
          poster={posterDark}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          data-lazy-video
        >
          {webmDark && <source src={webmDark} type="video/webm" />}
          {mp4Dark && <source src={mp4Dark} type="video/mp4" />}
        </video>
      </>
    ) : (
      <>
        <div class="slot-top">
          <span class="slot-dot" />
          <span class="slot-dot" />
          <span class="slot-dot" />
          <span class="slot-bar" />
        </div>
        <div
          class:list={[
            "slot-canvas",
            variant === "swarm" && "slot-canvas--swarm",
          ]}
          aria-hidden="true"
        >
          {variant === "swarm" ? (
            <>
              {swarmColumns.map((count, columnIndex) => (
                <div class="slot-col">
                  <span class="slot-colhead" />
                  {Array.from({ length: count }).map((_, cardIndex) => {
                    const active = columnIndex === 1 && cardIndex === 0;
                    const agent =
                      swarmAgents[
                        (columnIndex + cardIndex) % swarmAgents.length
                      ];
                    return (
                      <span
                        class:list={[
                          "slot-card",
                          active && "slot-card--active",
                        ]}
                      >
                        <i class="slot-line w80" />
                        <i class="slot-line w50" />
                        <span class="slot-row">
                          <i
                            class:list={["slot-agent", `slot-agent--${agent}`]}
                          />
                          {active && <i class="slot-check slot-check--on" />}
                        </span>
                      </span>
                    );
                  })}
                </div>
              ))}
              <span class="slot-presence slot-presence--roster">
                <i class="slot-avatar slot-avatar--a" />
                <i class="slot-avatar slot-avatar--b" />
                <i class="slot-avatar slot-avatar--c" />
                <i class="slot-avatar slot-avatar--d" />
              </span>
              <span class="slot-bubble">
                <i class="slot-avatar slot-avatar--b" />
                <span class="slot-bubble-lines">
                  <i class="slot-line w80" />
                  <i class="slot-line w50" />
                </span>
              </span>
            </>
          ) : variant === "selfhost" ? (
            <div class="slot-term">
              <span>
                <b>$</b> docker compose up -d
              </span>
              <span class="slot-ok">✓ postgres ready</span>
              <span class="slot-ok">✓ janosik ready on :3000</span>
              <span>
                <b>$</b> <i class="slot-caret" />
              </span>
            </div>
          ) : variant === "cards" ? (
            <div class="slot-detail">
              <span class="slot-line w70" />
              <span class="slot-detail-row">
                <i class="slot-check slot-check--on" />
                <span class="slot-line w60" />
              </span>
              <span class="slot-detail-row">
                <i class="slot-check slot-check--on" />
                <span class="slot-line w40" />
              </span>
              <span class="slot-detail-row">
                <i class="slot-check" />
                <span class="slot-line w50" />
              </span>
              <span class="slot-pills">
                <i />
                <i />
                <i />
              </span>
              <span class="slot-attach" />
            </div>
          ) : (
            <>
              <div class="slot-col">
                <span class="slot-colhead" />
                <span class="slot-card">
                  <i class="slot-line w80" />
                  <i class="slot-line w50" />
                </span>
                <span class="slot-card slot-card--accent">
                  <i class="slot-line w70" />
                  <span class="slot-pills">
                    <i />
                    <i />
                  </span>
                </span>
                <span class="slot-card">
                  <i class="slot-line w60" />
                </span>
              </div>
              <div class="slot-col">
                <span class="slot-colhead" />
                <span class="slot-card">
                  <i class="slot-line w70" />
                  <i class="slot-check" />
                </span>
                <span class="slot-card">
                  <i class="slot-line w90" />
                  <i class="slot-line w40" />
                </span>
              </div>
              <div class="slot-col">
                <span class="slot-colhead" />
                <span class="slot-card">
                  <i class="slot-line w60" />
                </span>
                <span class="slot-card">
                  <i class="slot-line w50" />
                </span>
              </div>
            </>
          )}

          {variant === "realtime" && (
            <>
              <span class="slot-presence">
                <i class="slot-avatar slot-avatar--a" />
                <i class="slot-avatar slot-avatar--b" />
              </span>
              <span class="slot-cursor">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M4 2l7 18 2.4-6.6L20 11z"
                    fill="currentColor"
                    stroke="var(--card)"
                    stroke-width="1.5"
                  />
                </svg>
                <b />
              </span>
            </>
          )}

          {variant === "sharing" && (
            <span class="slot-share">
              <span class="slot-avatars">
                <i class="slot-avatar slot-avatar--a" />
                <i class="slot-avatar slot-avatar--b" />
                <i class="slot-avatar slot-avatar--c" />
              </span>
              <span class="slot-link">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
                <i class="slot-line w80" />
              </span>
            </span>
          )}
        </div>
      </>
    )}
  </div>
</figure>
