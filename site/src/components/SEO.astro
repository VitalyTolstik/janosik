---
import { site } from "../config";
import { languages, type Lang } from "../i18n/ui";
import { localizePath, stripLocale } from "../i18n/utils";
import { plans } from "../pricing";
import { withBase } from "../utils/url";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
  /** Extra JSON-LD nodes (FAQPage, Product, …) merged into the graph. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Breadcrumb trail; rendered as a BreadcrumbList. */
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title,
  description,
  lang,
  image = "/og.png",
  noindex = false,
  type = "website",
  schema,
  breadcrumbs,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase(image), Astro.site);
const absolute = (path: string) => new URL(withBase(path), Astro.site).href;

// hreflang alternates — the same page in every language.
const pagePath = stripLocale(Astro.url.pathname);
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: absolute(localizePath(pagePath, code)),
}));

const locale = lang === "ru" ? "ru_RU" : "en_US";

// Prices come from `pricing.ts`, so the structured data can never drift from
// the pricing page. Non-numeric tiers (Enterprise) are left out of `offers`.
const offers = plans
  .filter((plan) => typeof plan.price.monthly === "number")
  .map((plan) => ({
    "@type": "Offer",
    name: plan.id,
    price: String(plan.price.monthly),
    priceCurrency: "USD",
  }));

const homeUrl = absolute("/");

const baseSchema: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.name,
    url: homeUrl,
    logo: ogImage.href,
    description: site.description,
    sameAs: [site.githubUrl],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: homeUrl,
    inLanguage: lang,
    license: "https://www.gnu.org/licenses/agpl-3.0.html",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: site.name,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web, self-hosted",
    description: site.description,
    url: homeUrl,
    license: "https://www.gnu.org/licenses/agpl-3.0.html",
    sameAs: [site.githubUrl],
    offers,
  },
];

// BreadcrumbList keeps the pricing page's hierarchy machine-readable. Note:
// FAQPage and Product markup are kept for semantic clarity and AI engines —
// Google retired FAQ rich results in 2026, so these are not a route to a
// search appearance.
const breadcrumbSchema = breadcrumbs
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: absolute(crumb.path),
      })),
    }
  : undefined;

const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const structuredData = [
  ...baseSchema,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...extra,
];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{alternates.map((alternate) => (
  <link rel="alternate" hreflang={alternate.code} href={alternate.href} />
))}
<link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage.href} />
<meta property="og:locale" content={locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.href} />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
