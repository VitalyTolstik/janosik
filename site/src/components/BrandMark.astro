---
interface Props {
  lang: string;
  placement: "header" | "footer";
}

const gradientId = `janosik-site-feather-grad-${Astro.props.lang}-${Astro.props.placement}`;
---

<span class="janosik-brand-tile" aria-hidden="true">
  <svg
    class="janosik-feather"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
  >
    <defs>
      <linearGradient id={gradientId} x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="currentColor" stop-opacity="0.95" />
        <stop offset="1" stop-color="currentColor" stop-opacity="0.72" />
      </linearGradient>
    </defs>
    <path
      d="M14.086 18.412A2 2 0 0112.67 19H5v-7.672a2 2 0 01.586-1.414L11.75 3.75a6 6 0 118.49 8.49z"
      fill={`url(#${gradientId})`}
    />
    <path
      d="M16 8 2 22"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
    />
    <path
      d="M16.5 15H9"
      stroke="currentColor"
      stroke-width="1.1"
      stroke-linecap="round"
      opacity="0.6"
    />
  </svg>
  <svg class="janosik-sparkle" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 0c.9 5.2 3.6 7.8 12 12-8.4 4.2-11.1 6.8-12 12-.9-5.2-3.6-7.8-12-12 8.4-4.2 11.1-6.8 12-12z" />
  </svg>
</span>
