---
import { appLink, site } from "../../config";
import type { Lang, UIKey } from "../../i18n/ui";
import { localizedUrl, useTranslations } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../utils/url";
import MediaSlot, { type MediaVariant } from "../MediaSlot.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const title = t("seo.home.title");
const description = t("seo.home.description");

// Feature clips rendered by the `video/` workspace into `site/public/media`.
// Each slot variant maps to one clip; the poster doubles as its still.
const clipSlug: Record<MediaVariant, string> = {
  swarm: "hero-swarm",
  board: "feature-board",
  realtime: "feature-realtime",
  cards: "feature-cards",
  sharing: "feature-sharing",
  selfhost: "feature-selfhost",
  watch: "feature-watch",
};

const clip = (variant: MediaVariant) => {
  const slug = clipSlug[variant];
  return {
    mp4: withBase(`/media/${slug}.mp4`),
    webm: withBase(`/media/${slug}.webm`),
    poster: withBase(`/media/${slug}.jpg`),
    mp4Dark: withBase(`/media/${slug}-dark.mp4`),
    webmDark: withBase(`/media/${slug}-dark.webm`),
    posterDark: withBase(`/media/${slug}-dark.jpg`),
  };
};

// Icons are inline so they inherit `currentColor`; the `-icon` svg shells are
// identical, only the geometry differs.
const icon = (paths: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

// The big features get their own row with a media slot, alternating sides.
const rows: {
  title: UIKey;
  body: UIKey;
  variant: MediaVariant;
  slot: UIKey;
  flip?: boolean;
}[] = [
  {
    title: "home.row.board.title",
    body: "home.row.board.body",
    variant: "board",
    slot: "home.slot.board",
  },
  {
    title: "home.row.realtime.title",
    body: "home.row.realtime.body",
    variant: "realtime",
    slot: "home.slot.realtime",
    flip: true,
  },
  {
    title: "home.row.cards.title",
    body: "home.row.cards.body",
    variant: "cards",
    slot: "home.slot.cards",
  },
  {
    title: "home.row.sharing.title",
    body: "home.row.sharing.body",
    variant: "sharing",
    slot: "home.slot.sharing",
    flip: true,
  },
  {
    title: "home.row.watch.title",
    body: "home.row.watch.body",
    variant: "watch",
    slot: "home.slot.watch",
  },
];

// The rest of the board's craft, as a light two-column list.
const more: { icon: string; key: UIKey }[] = [
  {
    icon: icon(
      '<path d="M4 7V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2"/><path d="M9 20h6"/><path d="M12 3v17"/>',
    ),
    key: "home.more.wysiwyg",
  },
  {
    icon: icon(
      '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
    ),
    key: "home.more.checklists",
  },
  {
    icon: icon(
      '<path d="M20.6 13.4 12 22l-8.6-8.6a2 2 0 0 1 0-2.8l6-6a2 2 0 0 1 2.8 0l8.4 8.4a2 2 0 0 1 0 2.4z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
    ),
    key: "home.more.labels",
  },
  {
    icon: icon('<path d="M3 5h18"/><path d="M6 12h12"/><path d="M10 19h4"/>'),
    key: "home.more.filter",
  },
  {
    icon: icon(
      '<rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M6 14h.01M10 14h.01M14 14h.01M18 14h.01"/>',
    ),
    key: "home.more.hotkeys",
  },
  {
    icon: icon(
      '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18"/><path d="M8 2v4M16 2v4"/>',
    ),
    key: "home.more.views",
  },
  {
    icon: icon(
      '<path d="M12 20h.01"/><path d="M8.5 16.4a5 5 0 0 1 7 0"/><path d="M5 12.9a10 10 0 0 1 5.5-2.9"/><path d="M2 8.8A15 15 0 0 1 8 6.1"/><path d="m2 2 20 20"/>',
    ),
    key: "home.more.offline",
  },
  {
    icon: icon(
      '<circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/>',
    ),
    key: "home.more.apikeys",
  },
  {
    icon: icon(
      '<path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/><path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/><circle cx="12" cy="12" r="2"/><path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/><path d="M19.1 4.9C23 8.8 23 15.1 19.1 19"/>',
    ),
    key: "home.more.share",
  },
  {
    icon: icon('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>'),
    key: "home.more.admin",
  },
];

// The swarm section: how agents drive the board and how you watch them.
const swarmSteps: { title: UIKey; body: UIKey }[] = [
  { title: "home.swarm.step1.title", body: "home.swarm.step1.body" },
  { title: "home.swarm.step2.title", body: "home.swarm.step2.body" },
  { title: "home.swarm.step3.title", body: "home.swarm.step3.body" },
];

const swarmPoints: UIKey[] = [
  "home.swarm.point1",
  "home.swarm.point2",
  "home.swarm.point3",
];

// A real request/response from the command API (the same one the UI uses).
const codeSample = `POST /api/v1/boards/:id/commands
{
  "commandId": "cmd_7f3a91",
  "action": {
    "type": "MOVE_CARD",
    "cardId": "card_demo07",
    "toColumnId": "col_review"
  }
}

200 OK
{ "seq": 412, "versions": { "card_demo07": 8 } }`;

const ossPoints: UIKey[] = [
  "home.oss.point1",
  "home.oss.point2",
  "home.oss.point3",
];

const steps: { title: UIKey; body: UIKey }[] = [
  { title: "home.how.step1.title", body: "home.how.step1.body" },
  { title: "home.how.step2.title", body: "home.how.step2.body" },
  { title: "home.how.step3.title", body: "home.how.step3.body" },
  { title: "home.how.step4.title", body: "home.how.step4.body" },
];

const faq: { q: UIKey; a: UIKey }[] = [
  { q: "home.faq.q1", a: "home.faq.a1" },
  { q: "home.faq.q2", a: "home.faq.a2" },
  { q: "home.faq.q3", a: "home.faq.a3" },
  { q: "home.faq.q4", a: "home.faq.a4" },
  { q: "home.faq.q5", a: "home.faq.a5" },
  { q: "home.faq.q6", a: "home.faq.a6" },
];

// Semantic FAQ markup. Google retired FAQ rich results, so this exists to help
// AI engines and other consumers parse the answers, not to win a snippet.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: t(item.q),
    acceptedAnswer: { "@type": "Answer", text: t(item.a) },
  })),
};
---

<BaseLayout {title} {description} {lang} schema={faqSchema}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title">{t("home.hero.title")}</h1>
        <p class="lead hero-lead">{t("home.hero.lead")}</p>
        <div class="hero-actions">
          <a
            class="btn btn-primary btn-lg"
            href={appLink(lang, "register")}
            data-cta="hero-signup"
          >
            {t("cta.primary")}
          </a>
          <a
            class="btn btn-ghost btn-lg"
            href={site.githubUrl}
            data-cta="hero-github"
          >
            {t("cta.secondary")}
          </a>
        </div>
        <p class="hero-note">{t("home.hero.note")}</p>
      </div>
      <MediaSlot
        class="hero-slot"
        variant="swarm"
        label={t("home.slot.swarm")}
        {...clip("swarm")}
      />
    </div>
  </section>

  <section class="section" id="swarm">
    <div class="container">
      <div class="section-head">
        <h2>{t("home.swarm.title")}</h2>
        <p class="lead">{t("home.swarm.lead")}</p>
      </div>

      <div class="swarm">
        <ol class="swarm-steps">
          {swarmSteps.map((step) => (
            <li>
              <h3>{t(step.title)}</h3>
              <p class="muted">{t(step.body)}</p>
            </li>
          ))}
        </ol>

        <div class="swarm-aside">
          <figure class="swarm-code">
            <pre class="code"><code>{codeSample}</code></pre>
            <figcaption class="sr-only">{t("home.swarm.code")}</figcaption>
          </figure>
          <ul class="oss-points">
            {swarmPoints.map((point) => (
              <li>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{t(point)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <div class="section-head">
        <h2>{t("home.features.title")}</h2>
        <p class="lead">{t("home.features.lead")}</p>
      </div>

      <div class="feature-rows">
        {rows.map((row) => (
          <article
            class:list={["feature-row", row.flip && "feature-row--flip"]}
          >
            <div class="feature-row-copy">
              <h3>{t(row.title)}</h3>
              <p class="muted">{t(row.body)}</p>
            </div>
            <MediaSlot
              class="feature-row-slot"
              variant={row.variant}
              label={t(row.slot)}
              {...clip(row.variant)}
            />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <h2>{t("home.more.title")}</h2>
        <p class="lead">{t("home.more.lead")}</p>
      </div>
      <ul class="more-grid">
        {more.map((item) => (
          <li class="more-item">
            <span class="more-icon" set:html={item.icon} />
            <span>{t(item.key)}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="oss">
        <div class="oss-copy">
          <h2>{t("home.oss.title")}</h2>
          <p class="muted">{t("home.oss.body")}</p>
          <ul class="oss-points">
            {ossPoints.map((point) => (
              <li>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{t(point)}</span>
              </li>
            ))}
          </ul>
          <div class="hero-actions">
            <a
              class="btn btn-primary"
              href={site.githubUrl}
              data-cta="oss-github"
            >
              {t("cta.secondary")}
            </a>
            <a class="btn btn-ghost" href={appLink(lang)} data-cta="oss-signin">
              {t("cta.signin")}
            </a>
          </div>
        </div>
        <MediaSlot
          class="oss-slot"
          variant="selfhost"
          label={t("home.slot.selfhost")}
          {...clip("selfhost")}
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{t("home.how.title")}</h2>
        <p class="lead">{t("home.how.lead")}</p>
      </div>
      <ol class="steps">
        {steps.map((step) => (
          <li>
            <h3>{t(step.title)}</h3>
            <p class="muted">{t(step.body)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{t("home.faq.title")}</h2>
      </div>
      <div class="faq">
        {faq.map((item) => (
          <details>
            <summary>{t(item.q)}</summary>
            <p>{t(item.a)}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="cta-band">
        <h2>{t("home.pricing.title")}</h2>
        <p class="lead">{t("home.pricing.lead")}</p>
        <div class="hero-actions">
          <a
            class="btn btn-primary btn-lg"
            href={localizedUrl("/pricing", lang)}
            data-cta="home-pricing"
          >
            {t("home.pricing.cta")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>{t("home.cta.title")}</h2>
        <p class="lead">{t("home.cta.lead")}</p>
        <div class="hero-actions">
          <a
            class="btn btn-primary btn-lg"
            href={appLink(lang, "register")}
            data-cta="footer-signup"
          >
            {t("cta.primary")}
          </a>
          <a
            class="btn btn-ghost btn-lg"
            href={site.githubUrl}
            data-cta="footer-github"
          >
            {t("cta.secondary")}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
