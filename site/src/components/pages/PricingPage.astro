---
import { appLink, contactLink, site } from "../../config";
import type { Lang, UIKey } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  cardPlanIds,
  columnIds,
  comparison,
  currency,
  planById,
  planKey,
  plans,
  type Plan,
  type Value,
} from "../../pricing";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const title = t("seo.pricing.title");
const description = t("seo.pricing.description");

// All plan data lives in `pricing.ts`; here we only turn it into markup. The
// CTAs resolve to a URL until billing arrives (TASK-131).
const linkUrl: Record<Plan["link"], string> = {
  github: site.githubUrl,
  waitlist: contactLink(t("pricing.waitlist.subject")),
};

// One check glyph, reused everywhere; `currentColor` lets it pick up its context.
const check =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

// A `Value` is a bare number or an i18n key; prices get the currency prefix.
const renderValue = (value: Value) =>
  typeof value === "number" ? String(value) : t(value);
const renderPrice = (value: Value) =>
  typeof value === "number" ? `${currency}${value}` : t(value);

const cards = cardPlanIds.map((id) => planById[id]);

const limitFields: { labelKey: UIKey; field: keyof Plan["limits"] }[] = [
  { labelKey: "pricing.limit.boards", field: "boards" },
  { labelKey: "pricing.limit.members", field: "members" },
  { labelKey: "pricing.limit.storage", field: "storage" },
];

const limitLine = (plan: Plan) =>
  limitFields
    .map(
      ({ labelKey, field }) =>
        `${t(labelKey)}: ${renderValue(plan.limits[field])}`,
    )
    .join(" · ");

const faq: { q: UIKey; a: UIKey }[] = [
  { q: "pricing.faq.q1", a: "pricing.faq.a1" },
  { q: "pricing.faq.q2", a: "pricing.faq.a2" },
  { q: "pricing.faq.q3", a: "pricing.faq.a3" },
  { q: "pricing.faq.q4", a: "pricing.faq.a4" },
];

// Structured data. FAQ + Product are semantic (Google retired FAQ rich
// results); the offer range is derived from `pricing.ts` so it cannot drift.
const numericPrices = plans
  .map((plan) => plan.price)
  .filter((price): price is number => typeof price === "number");

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: t(item.q),
    acceptedAnswer: { "@type": "Answer", text: t(item.a) },
  })),
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: site.name,
  description: description,
  brand: { "@type": "Brand", name: site.name },
  category: "BusinessApplication",
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "USD",
    lowPrice: String(Math.min(...numericPrices)),
    highPrice: String(Math.max(...numericPrices)),
    offerCount: numericPrices.length,
  },
};

const breadcrumbs = [
  { name: t("breadcrumb.home"), path: "/" },
  { name: t("pricing.title"), path: "/pricing" },
];
---

<BaseLayout
  {title}
  {description}
  {lang}
  image="/og-pricing.png"
  schema={[faqSchema, productSchema]}
  {breadcrumbs}
>
  <div class="pricing-page">
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h1>{t("pricing.title")}</h1>
          <p class="lead">{t("pricing.lead")}</p>
        </div>

        <div class="plans">
          {cards.map((plan) => (
            <article class:list={["plan", plan.featured && "plan--featured"]}>
              {plan.featured && <span class="badge">{t("pricing.badge")}</span>}
              <h2 class="plan-name">{t(planKey(plan.id, "name"))}</h2>
              <p class="plan-for">{t(planKey(plan.id, "for"))}</p>

              <p class="plan-price">
                <span class="price-num">{renderPrice(plan.price)}</span>
                <span class="price-period">{t(plan.period)}</span>
              </p>

              <p class="plan-limits">{limitLine(plan)}</p>

              <ul class="plan-features">
                {plan.highlights.map((key) => (
                  <li>
                    <span class="plan-check" set:html={check} />
                    <span>{t(key)}</span>
                  </li>
                ))}
              </ul>

              <a
                class:list={[
                  "btn",
                  plan.featured ? "btn-primary" : "btn-ghost",
                ]}
                href={linkUrl[plan.link]}
                data-cta={`plan-${plan.id}`}
              >
                {t(planKey(plan.id, "cta"))}
              </a>
            </article>
          ))}
        </div>

        <p class="muted pricing-note">{t("pricing.note")}</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>{t("pricing.compare.title")}</h2>
          <p class="lead">{t("pricing.compare.lead")}</p>
        </div>

        <div
          class="compare"
          role="region"
          aria-label={t("pricing.compare.aria")}
          tabindex="0"
        >
          <table class="compare-table">
            <thead>
              <tr>
                <th scope="col">{t("pricing.compare.feature")}</th>
                {columnIds.map((id) => (
                  <th scope="col">{t(planKey(id, "name"))}</th>
                ))}
              </tr>
            </thead>
            {comparison.map((category) => (
              <tbody>
                <tr>
                  <th scope="colgroup" colspan={columnIds.length + 1}>
                    {t(category.titleKey)}
                  </th>
                </tr>
                {category.rows.map((row) => (
                  <tr>
                    <th scope="row">{t(row.labelKey)}</th>
                    {row.cells.map((cell) =>
                      typeof cell === "boolean" ? (
                        cell ? (
                          <td>
                            <span class="cell-yes">
                              <Fragment set:html={check} />
                              <span class="sr-only">
                                {t("pricing.compare.yes")}
                              </span>
                            </span>
                          </td>
                        ) : (
                          <td>
                            <span class="cell-no">
                              <span class="sr-only">
                                {t("pricing.compare.no")}
                              </span>
                              <span aria-hidden="true">—</span>
                            </span>
                          </td>
                        )
                      ) : (
                        <td>{renderValue(cell)}</td>
                      ),
                    )}
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>{t("pricing.faq.title")}</h2>
        </div>
        <div class="faq">
          {faq.map((item) => (
            <details>
              <summary>{t(item.q)}</summary>
              <p>{t(item.a)}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="cta-band">
          <h2>{t("pricing.cta.title")}</h2>
          <p class="lead">{t("pricing.cta.lead")}</p>
          <div class="hero-actions">
            <a
              class="btn btn-primary btn-lg"
              href={appLink(lang, "register")}
              data-cta="pricing-signup"
            >
              {t("cta.signup")}
            </a>
            <a
              class="btn btn-ghost btn-lg"
              href={site.githubUrl}
              data-cta="pricing-github"
            >
              {t("cta.secondary")}
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
