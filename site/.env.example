# Marketing site (Astro). Copy to `site/.env` for local overrides — Astro/Vite
# loads it from this directory, and only PUBLIC_* variables reach the browser.

# Where the "Sign in" / "Create account" CTAs point.
# Defaults to `<base>app` (= `/app/`), which is correct for the self-host image
# (site at `/`, app at `/app/`). In dev the app runs on its own Vite server
# (port 5173), so set this or the CTAs 404 against `:4321/app/`:
PUBLIC_APP_URL=http://localhost:5173

# PUBLIC_CONTACT_EMAIL=hello@janosik.app