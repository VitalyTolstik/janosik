# Janosik — Caddy front for 2–4 API replicas (TASK-200.12).
#
# Mounted by docker-compose.scale.yml at /etc/caddy/Caddyfile. Use it by
# setting JANOSIK_PROXY_IMAGE=caddy:2-alpine (the Compose file mounts both
# this file and nginx.conf; each image reads its own config).
#
# This is the plain-HTTP listener on :8080 (published as PORT, 3000 by
# default). Put a TLS terminator in front, or replace `:8080` with your
# domain (e.g. `kanban.example.com`), remove `auto_https off`, and change the
# Compose proxy mapping from `${PORT}:8080` to `80:80` and `443:443` so Caddy
# can obtain a certificate. `reverse_proxy app:3000` resolves every Compose
# replica and load-balances round-robin; Caddy re-resolves after a reload.
#
# Contract mirrors deploy/scale/nginx.conf:
#   - `encode gzip` for identity text/JSON; already-encoded API responses pass
#     through untouched;
#   - `flush_interval -1` forces immediate SSE writes (no proxy buffering);
#     the transport read/write timeout is far above the 60 s PAT keep-alive;
#   - query strings (`?since=`) and uploads pass through verbatim;
#   - no sticky sessions are required.
#
# Validate: caddy validate --config deploy/scale/Caddyfile
# Reload after a scale/rollout: docker compose ... exec proxy \
#   caddy reload --config /etc/caddy/Caddyfile

{
    # The proxy is intentionally a plain HTTP container; TLS is either an
    # outer proxy or this Caddyfile changed to a real domain.
    auto_https off
    # Behind an outer TLS proxy, add only that proxy's exact network here so
    # Caddy preserves the client IP and X-Forwarded-Proto. Do not trust every
    # private address: direct LAN clients could then spoof X-Forwarded-For.
    #   servers { trusted_proxies static 172.18.0.0/16 }
}

:8080 {
    # Compress site/app assets. The API negotiates gzip/Brotli itself for
    # large board reads and streams SSE; excluding /api/ keeps both semantics,
    # and avoids any compression wrapper around event-stream frames.
    @static not path /api/*
    encode @static gzip

    route {
        # SSE has its own upstream block: no buffering and a 3600 s read/write
        # timeout, far above the 60 s PAT / 25 s human keep-alive. Ordinary API
        # requests use the 90 s block below.
        @sse path /api/v1/boards/*/events* /api/v1/share/*/events*
        handle @sse {
            reverse_proxy app:3000 {
                flush_interval -1
                lb_policy round_robin
                lb_try_duration 10s
                lb_try_interval 250ms
                fail_duration 30s
                max_fails 3
                transport http {
                    dial_timeout 5s
                    read_timeout 3600s
                    write_timeout 3600s
                    keepalive 30s
                    keepalive_idle_conns 64
                }
            }
        }

        # Uploads, attachment reads and avatar reads/writes may be large and
        # slow. Caddy streams request bodies; the API enforces the real caps.
        @uploads path /api/v1/cards/*/attachments /api/v1/users/*/avatar /api/v1/boards/import /api/v1/attachments/*/content /api/v1/attachments/*/thumbnail /api/v1/attachments/*/poster
        handle @uploads {
            reverse_proxy app:3000 {
                lb_policy round_robin
                lb_try_duration 10s
                lb_try_interval 250ms
                fail_duration 30s
                max_fails 3
                transport http {
                    dial_timeout 5s
                    read_timeout 3600s
                    write_timeout 3600s
                    keepalive 30s
                    keepalive_idle_conns 64
                }
            }
        }

        # Compose healthcheck: proxy the API readiness probe (DB + configured
        # Redis) so an unhealthy replica set turns the proxy unhealthy too.
        handle /healthz {
            rewrite * /api/v1/health/ready
            reverse_proxy app:3000 {
                lb_policy round_robin
                lb_try_duration 5s
                lb_try_interval 250ms
                fail_duration 30s
                max_fails 3
                transport http {
                    dial_timeout 5s
                    read_timeout 10s
                    write_timeout 10s
                }
            }
        }

        # Normal API and static/frontend requests: 90 s covers the 60 s ready
        # long-poll and no longer hides a stuck call for an hour.
        reverse_proxy app:3000 {
            lb_policy round_robin
            lb_try_duration 10s
            lb_try_interval 250ms
            fail_duration 30s
            max_fails 3
            transport http {
                dial_timeout 5s
                read_timeout 90s
                write_timeout 90s
                keepalive 30s
                keepalive_idle_conns 64
            }
        }
    }
}
