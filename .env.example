# Janosik — environment for docker compose (TASK-38b).
# Copy to `.env` next to docker-compose.yml and fill in the values:
#   cp .env.example .env
# Then: docker compose up -d
#
# Only JWT_SECRET, POSTGRES_PASSWORD and PUBLIC_ORIGIN really need your
# attention. A plain-HTTP trial host must also set COOKIE_SECURE=false (see
# Security below); behind HTTPS everything else has a sane default.

# --- Required -------------------------------------------------------------

# Signing secret for access tokens. REQUIRED — the API refuses to boot
# without it. Generate one: openssl rand -hex 32
JWT_SECRET=

# Postgres credentials (created on first `up`). Use URL-safe characters in the
# password because Compose inserts it into DATABASE_URL; openssl rand -hex 32
# generates a suitable password.
POSTGRES_USER=janosik
POSTGRES_PASSWORD=change-me
POSTGRES_DB=janosik

# The URL users open in the browser. Must match the scheme/host you actually
# serve on (it builds OAuth callbacks and the Secure-cookie check). For a LAN
# quickstart this is http://localhost:3000; for real use, https://your.domain.
PUBLIC_ORIGIN=http://localhost:3000

# --- Security -------------------------------------------------------------

# Secure refresh cookie. `true` (the default) is correct behind HTTPS — the
# only safe production setting. A *plain-HTTP* trial (localhost / LAN) must
# set it to `false`, and the API then logs a loud warning; with it left `true`
# over HTTP the app refuses to boot rather than silently drop the cookie.
COOKIE_SECURE=true

# Self-service signup requires SMTP or the one-time bootstrap below.
# Without either, create a master with the CLI and use Users → Create user.
# Turn off signup for a private instance. The master panel can override
# this setting at runtime (Feature flags).
ALLOW_REGISTRATION=true

# One-time fresh-install bootstrap without SMTP. When true and no user exists,
# the first registration is auto-verified; after that it is inert. Set it back
# to false (and configure SMTP) before exposing the instance.
ALLOW_BOOTSTRAP_USER=false

# Trusted reverse-proxy hops. 0 = none (the port is published directly).
# Set to 1 when nginx/Caddy/Traefik sits in front, so rate limits and the
# audit log see the real client IP instead of the proxy's. Leave it commented
# for the default single-container install; the scaled overlay defaults to 1
# (and 2 when an external TLS proxy also sits in front).
# TRUST_PROXY=0

# --- Optional -------------------------------------------------------------

# Host port to publish (container always listens on 3000).
# PORT=3000
# Bind only to the host when a reverse proxy provides public access.
# APP_BIND_ADDRESS=127.0.0.1

# --- Horizontal scale (optional overlay) ----------------------------------
# The default stack is one app container. For 2-4 replicas behind the bundled
# nginx/Caddy proxy, also use docker-compose.scale.yml (see the self-hosting
# guide). These values are ignored by the single-container stack; TRUST_PROXY
# above is read only when explicitly set (the overlay defaults to 1).
# API_REPLICAS=3
# API_CPUS=1.0
# API_MEMORY_LIMIT=1536M
# API_NOFILE=65536
# SSE_MAX_CONNECTIONS=2000
# DB_CONNECTION_LIMIT and NODE_OPTIONS are set below; size the heap below the
# per-replica memory limit.
# Proxy sizing: 512M/0.5 CPU is the 4 vCPU/8 GB start; use 1G/1 CPU on the
# 16 vCPU/32 GB profile. PROXY_NOFILE must cover client + upstream connections.
# PROXY_CPUS=0.5
# PROXY_MEMORY_LIMIT=512M
# PROXY_NOFILE=131072
# Choose caddy:2-alpine for the Caddyfile; nginx is the default.
# JANOSIK_PROXY_IMAGE=nginx:1.27-alpine

# Image tag to run (e.g. a released version like v0.2.0).
# JANOSIK_TAG=latest

# Bull Board queue dashboard at /api/v1/admin/queues (OWNER-only). Off by default.
# QUEUES_DASHBOARD=false

# Outgoing email. Without SMTP_HOST, no email is sent; production logs omit
# message contents. Password registration requires working email delivery.
# Configure a transport here or in the master panel (Email service):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@example.com
# SMTP_PASS=app-password
# SMTP_FROM="Janosik <no-reply@example.com>"

# OAuth login (Google / Yandex) is configured in the master panel, not here.

# Encryption key for panel-saved SMTP credentials (derived from JWT_SECRET
# when unset):
# SETTINGS_SECRET=

# Soft-delete purge window in days (fallback when the panel has no setting):
# PURGE_AFTER_DAYS=30
# UNVERIFIED_ACCOUNT_TTL_DAYS=14

# TASK-166: server-mode board cap per account; 0 = unlimited (product default).
# MAX_BOARDS_PER_USER=0

# Master audit-log retention in days (separate, longer window):
# AUDIT_RETENTION_DAYS=365

# Database pool per API process (replicas × this must stay under the
# server's max_connections) and slow-query logging threshold in ms:
# DB_CONNECTION_LIMIT=10
# SLOW_QUERY_MS=200

# Node heap ceiling (V8 old space) for the API process. Bounds memory so a
# live-stream surge triggers GC instead of the container OOM-killer; raise it
# on a bigger box. The image ships a 1024 MB default.
# NODE_OPTIONS=--max-old-space-size=1024

# Short-TTL read caches. A hot public-share link rebuilds its board aggregate
# at most once per window (invalidated the moment the board's command seq
# moves); the master metrics snapshot is served from a short cache too. The
# window bounds how stale a share's member roster may be. 0 disables each.
# SHARE_AGGREGATE_CACHE_MS=2000
# ADMIN_METRICS_CACHE_MS=5000

# TASK-200.6 full board reads (`GET /boards/:id`). The cap is per API process;
# with N replicas the cluster can build N × BOARD_READ_CAP aggregates at once.
# Identical concurrent reads coalesce before the cap. Distinct readers beyond
# BOARD_READ_QUEUE_MAX get 503 board_read_busy immediately; a caller queued
# longer than BOARD_READ_WAIT_MS or exceeding the single shared
# BOARD_READ_TIMEOUT_MS deadline (must be greater and at least 300 ms) gets
# 503 + Retry-After. Stamp, queue, transaction and encoding each get only the
# remaining budget. The cap may exceed DB_CONNECTION_LIMIT (default 10): extra
# builds wait on the Prisma pool up to BOARD_READ_WAIT_MS, then get 503
# board_read_busy. WAIT_MS=0 disables semaphore queueing and pool wait, while
# stamp and transaction still use the shared deadline. The read transaction
# receives maxWait=min(WAIT_MS,budget) when WAIT_MS>0 (WAIT_MS=0 => maxWait 0)
# and timeout=remaining−encode margin; P2024/P2028
# map to a 503, not a 500. JSON below the byte threshold stays uncompressed;
# larger bodies negotiate gzip/Brotli (implicit identity is q=1, so gzip;q=0.5
# selects identity).
# BOARD_READ_CAP=16
# BOARD_READ_QUEUE_MAX=256
# BOARD_READ_WAIT_MS=10000
# BOARD_READ_TIMEOUT_MS=20000
# BOARD_READ_RETRY_AFTER_SECONDS=2
# BOARD_READ_COMPRESS_MIN_BYTES=1024

# Bundled Postgres container tuning (Compose profile):
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_WORK_MEM=8MB
# POSTGRES_MAX_CONNECTIONS=100
