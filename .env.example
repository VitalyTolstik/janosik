# Janosik — environment for docker compose (TASK-38b).
# Copy to `.env` next to docker-compose.yml and fill in the values:
#   cp .env.example .env
# Then: docker compose up -d
#
# Only JWT_SECRET, POSTGRES_PASSWORD and PUBLIC_ORIGIN really need your
# attention. Everything else has a sane default.

# --- Required -------------------------------------------------------------

# Signing secret for access tokens. REQUIRED — the API refuses to boot
# without it. Generate one: openssl rand -hex 32
JWT_SECRET=

# Postgres credentials (created on first `up`; pick a strong password).
POSTGRES_USER=janosik
POSTGRES_PASSWORD=change-me
POSTGRES_DB=janosik

# The URL users open in the browser. Must match the scheme/host you actually
# serve on (it builds OAuth callbacks and the Secure-cookie check). For a LAN
# quickstart this is http://localhost:3000; for real use, https://your.domain.
PUBLIC_ORIGIN=http://localhost:3000

# --- Security -------------------------------------------------------------

# Secure refresh cookie. `false` lets the plain-HTTP quickstart work (the API
# logs a loud warning). SET TO `true` (or delete this line) once you serve
# over HTTPS — otherwise the refresh cookie can be intercepted.
COOKIE_SECURE=false

# Open sign-up. Keep `true` for the very first run to create your account,
# then set to `false` so nobody else can register. Also toggleable at runtime
# in the master panel (Feature flags).
ALLOW_REGISTRATION=true

# Trusted reverse-proxy hops. 0 = none (the port is published directly).
# Set to 1 when nginx/Caddy/Traefik sits in front, so rate limits and the
# audit log see the real client IP instead of the proxy's.
TRUST_PROXY=0

# --- Optional -------------------------------------------------------------

# Host port to publish (container always listens on 3000).
# PORT=3000

# Image tag to run (e.g. a released version like v0.1.0).
# JANOSIK_TAG=latest

# Bull Board queue dashboard at /admin/queues (OWNER-only). Off by default.
# QUEUES_DASHBOARD=false

# Outgoing email. DELIVERY IS OFF BY DEFAULT: with no SMTP_HOST, every message
# (verification codes, notices) is written to the server log instead of being
# sent — nothing is emailed until you configure a transport here or in the
# master panel (Email service), so a bare install still works:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@example.com
# SMTP_PASS=app-password
# SMTP_FROM="Janosik <no-reply@example.com>"

# OAuth login (Google / Yandex) is configured in the master panel, not here.

# Encryption key for panel-saved SMTP credentials (derived from JWT_SECRET
# when unset):
# SETTINGS_SECRET=

# Soft-delete purge window in days (fallback when the panel has no setting):
# PURGE_AFTER_DAYS=30
