{
  "name": "@janosik/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Janosik API — NestJS + Prisma + PostgreSQL (see ROADMAP §7).",
  "license": "AGPL-3.0-or-later",
  "type": "commonjs",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestart": "prisma migrate deploy",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "db:indexes": "node scripts/db-indexes.cjs",
    "admin:create": "node scripts/admin-cli.cjs create",
    "admin:passwd": "node scripts/admin-cli.cjs passwd",
    "admin:list": "node scripts/admin-cli.cjs list",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "node scripts/migrate-test-db.cjs && jest --selectProjects e2e --runInBand",
    "test:ci": "npm run test"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.5",
    "@bull-board/express": "^9.10.5",
    "@bull-board/nestjs": "^9.10.5",
    "@bull-board/ui": "^9.10.5",
    "@janosik/shared": "*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.16.2",
    "prisma": "^6.16.2",
    "@types/multer": "^2.2.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "envalid": "^8.2.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "comment": "`prisma` is a runtime dependency (not dev): the container entrypoint runs `prisma migrate deploy` on boot (TASK-38b).",
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsc-alias": "^1.9.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
