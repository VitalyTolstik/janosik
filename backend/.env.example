# Copy to backend/.env — the real .env never lands in git.
# App vars are validated by envalid (backend/src/config/env.ts).
# Load order: .env → .env.${NODE_ENV} → .env.local (later wins).

# Dev DB from backend/docker-compose.yml (postgres 16 on localhost:5433).
DATABASE_URL="postgresql://janosik:janosik@localhost:5433/janosik"
# Test DB for e2e (`npm test -w backend` runs against this, not the dev one):
TEST_DATABASE_URL="postgresql://janosik:janosik@localhost:5433/janosik_test"
# API port (optional, default 3000):
# PORT=3000

# Postgres container credentials for backend/docker-compose.yml
# (dev-only throwaway values; never reuse in production):
POSTGRES_USER=janosik
POSTGRES_PASSWORD=janosik
POSTGRES_DB=janosik

# JWT access-token signing secret — REQUIRED, no default (the API refuses to
# boot without it). Generate a long random string: openssl rand -hex 32
JWT_SECRET=
# Access token lifetime (vercel/ms duration):
ACCESS_TOKEN_TTL="15m"
# Refresh token lifetime in days:
REFRESH_TOKEN_TTL_DAYS=30
# Blob storage root (attachments + avatars). Absolute path recommended —
# the default anchors to backend/data/uploads regardless of process cwd; a
# relative value is anchored to the backend package (TASK-120).
# UPLOAD_DIR="/absolute/path/to/backend/data/uploads"

# Reverse-proxy hops in front of the API (TASK-91). 0 = trust none (default).
# Behind one nginx set TRUST_PROXY=1 so the rate limiter, the admin IP
# allowlist and the session audit see the real client, not the proxy.
# TRUST_PROXY=1

# Open sign-up (TASK-38a). On by default so the first run can create an admin.
# Set to false on a public instance after your account exists — otherwise
# anyone can register. Also toggleable at runtime in the master panel.
# ALLOW_REGISTRATION=true

# Secure-cookie override (TASK-38a). Empty = auto: on in production, off in
# dev. A production install served over plain HTTP MUST set COOKIE_SECURE=false
# explicitly (the API otherwise refuses to boot rather than silently drop the
# refresh cookie). Not recommended — serve HTTPS instead.
# COOKIE_SECURE=false

# Soft-delete purge window in days (TASK-38a), used when the master panel has
# no retention setting. The hourly maintenance sweep deletes rows soft-deleted
# longer ago than this.
# PURGE_AFTER_DAYS=30

# Mail (TASK-51: email change verification). All optional — without
# SMTP_HOST outgoing emails are written to the server log instead of sent.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false        # true for implicit TLS (port 465)
# SMTP_USER="no-reply@example.com"
# SMTP_PASS="app-password"
# SMTP_FROM="Janosik <no-reply@example.com>"

# Retention for the master audit trail (TASK-148), separate from the
# soft-delete window:
# AUDIT_RETENTION_DAYS=365

# Prisma pool size per API process (TASK-153; 0 = Prisma's default). Keep
# replicas × this under the server's max_connections. Queries at or above
# SLOW_QUERY_MS are logged (0 = off):
# DB_CONNECTION_LIMIT=10
# SLOW_QUERY_MS=200

# Tuning for the bundled Postgres container (backend/docker-compose.yml):
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_WORK_MEM=8MB
# POSTGRES_MAX_CONNECTIONS=100

# Redis for BullMQ queues (TASK-62: outgoing-mail broadcast fan-out). Optional —
# unset keeps the in-process queue. The dev redis comes from docker-compose.
# REDIS_URL="redis://localhost:6379"

# Public base URL of the UI (TASK-54: OAuth login). Builds the provider
# callback URLs that must be registered verbatim in the Google/Yandex
# consoles, and the post-login redirect target. In production nginx serves
# the UI and API from one origin, so set it to that origin.
PUBLIC_ORIGIN="http://localhost:5173"

# Master-panel credential encryption (TASK-52; derived from JWT_SECRET when
# unset):
# SETTINGS_SECRET="openssl rand -hex 32"
