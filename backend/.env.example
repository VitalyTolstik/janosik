# Copy to backend/.env — the real .env never lands in git.
# App vars are validated by envalid (backend/src/config/env.ts).
# Load order: .env → .env.${NODE_ENV} → .env.local (later wins).

# Dev DB from backend/docker-compose.yml (postgres 16 on localhost:5433).
DATABASE_URL="postgresql://janosik:janosik@localhost:5433/janosik"
# Test DB for e2e (`npm test -w backend` runs against this, not the dev one):
TEST_DATABASE_URL="postgresql://janosik:janosik@localhost:5433/janosik_test"
# API port (optional, default 3000):
# PORT=3000

# Postgres container credentials for backend/docker-compose.yml
# (dev-only throwaway values; never reuse in production):
POSTGRES_USER=janosik
POSTGRES_PASSWORD=janosik
POSTGRES_DB=janosik

# JWT access-token signing secret — REQUIRED, no default (the API refuses to
# boot without it). Generate a long random string: openssl rand -hex 32
JWT_SECRET=
# Access token lifetime (vercel/ms duration):
ACCESS_TOKEN_TTL="15m"
# Refresh token lifetime in days:
REFRESH_TOKEN_TTL_DAYS=30
# Blob storage root (attachments + avatars). Absolute path recommended —
# the default anchors to backend/data/uploads regardless of process cwd; a
# relative value is anchored to the backend package (TASK-120).
# UPLOAD_DIR="/absolute/path/to/backend/data/uploads"

# Reverse-proxy hops in front of the API (TASK-91). 0 = trust none (default).
# Behind one nginx set TRUST_PROXY=1 so the rate limiter, the admin IP
# allowlist and the session audit see the real client, not the proxy.
# TRUST_PROXY=1

# TASK-166.10 / TASK-200.3 agent budgets (weighted units per minute). 0 = derive
# from the live THROTTLE_LIMIT: session = max(600, THROTTLE_LIMIT), token =
# max(600, ceil(THROTTLE_LIMIT / 4)), board = max(12000, 2 × THROTTLE_LIMIT).
# A pinned budget is 0 (auto) or at least 100, so a 100-command batch can fit.
# An explicit token rateLimitPerMinute is capped at the derived token share.
# The board value is a safety ceiling shared by every agent on the board; the
# token/session buckets keep one agent from exhausting it. A batch spends its
# command count against the board, token AND session budgets. Commands over the
# board ceiling wait up to AGENT_COMMAND_QUEUE_MS (0…30000) for a refill, then
# get 503 + Retry-After instead of an instant 429; the per-board queue holds at
# most 64 queued requests/batches / 32 MiB of serialized parsed JSON. Browser sessions are
# unaffected.
# AGENT_SESSION_RATE_LIMIT=0
# AGENT_TOKEN_RATE_LIMIT=0
# BOARD_RATE_LIMIT=0
# AGENT_COMMAND_QUEUE_MS=1500

# TASK-200.6 full board reads (GET /boards/:id). Identical concurrent reads
# share one build; distinct board/role/projection/coding groups are limited to
# BOARD_READ_CAP builds per process, with at most BOARD_READ_QUEUE_MAX waiters.
# A caller that waits BOARD_READ_WAIT_MS or exceeds the single shared
# BOARD_READ_TIMEOUT_MS deadline (must be greater, at least 300 ms) gets 503
# board_read_busy/board_read_timeout + Retry-After instead of an OOM. Stamp,
# queue, transaction and encoding each get only the remaining budget; WAIT_MS=0
# disables semaphore queueing and pool wait but stamp/transaction still use the
# shared deadline. The cap may exceed DB_CONNECTION_LIMIT: extra builds wait on
# the Prisma pool up to BOARD_READ_WAIT_MS. The transaction gets
# maxWait=min(WAIT_MS,budget) (WAIT_MS=0 => 0) and
# timeout=remaining−encode margin; P2024/P2028 answer 503, not 500.
# JSON bodies below BOARD_READ_COMPRESS_MIN_BYTES stay uncompressed; larger
# ones negotiate gzip/Brotli and always send Vary (implicit identity is q=1).
# BOARD_READ_CAP=16
# BOARD_READ_QUEUE_MAX=256
# BOARD_READ_WAIT_MS=10000
# BOARD_READ_TIMEOUT_MS=20000
# BOARD_READ_RETRY_AFTER_SECONDS=2
# BOARD_READ_COMPRESS_MIN_BYTES=1024

# TASK-200.5 hot-path auth caches (PAT by hash, board membership, feature
# flags). Windows in ms; the intended band is 10–30 s. Writes, pause/resume,
# revokes and flag updates invalidate through the realtime bus; the window only
# bounds a missed frame. 0 disables a cache (the test suite uses 0). Every cache
# is bounded LRU by the *_MAX_ENTRIES values. TTL/entry values must be
# non-negative integers; a negative value fails startup.
# AUTH_CACHE_TTL_MS=15000
# MEMBERSHIP_CACHE_TTL_MS=30000
# FEATURE_FLAG_CACHE_MS=30000
# AUTH_CACHE_MAX_ENTRIES=5000
# MEMBERSHIP_CACHE_MAX_ENTRIES=10000
# FEATURE_FLAG_CACHE_MAX_ENTRIES=64

# Self-service signup needs this flag and SMTP. The optional one-time
# ALLOW_BOOTSTRAP_USER=true path works without SMTP on an empty user table.
# With neither configured, create a master via admin:create, then create
# the first board user in the master panel.
# ALLOW_REGISTRATION=true

# Secure-cookie override (TASK-38a). Empty = auto: on in production, off in
# dev. A production install served over plain HTTP MUST set COOKIE_SECURE=false
# explicitly (the API otherwise refuses to boot rather than silently drop the
# refresh cookie). Not recommended — serve HTTPS instead.
# COOKIE_SECURE=false

# Soft-delete purge window in days (TASK-38a), used when the master panel has
# no retention setting. The hourly maintenance sweep deletes rows soft-deleted
# longer ago than this.
# PURGE_AFTER_DAYS=30
# Release an abandoned never-verified registration's e-mail after N days:
# UNVERIFIED_ACCOUNT_TTL_DAYS=14

# TASK-166: server-mode board cap per account; 0 = unlimited (product default).
# A positive value is an operator safety cap; local mode keeps its own 10-board
# localStorage guard.
# MAX_BOARDS_PER_USER=0

# Mail (TASK-51: email change verification). All optional — without
# SMTP_HOST outgoing emails are written to the server log instead of sent.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false        # true for implicit TLS (port 465)
# SMTP_USER="no-reply@example.com"
# SMTP_PASS="app-password"
# SMTP_FROM="Janosik <no-reply@example.com>"

# Retention for the master audit trail (TASK-148), separate from the
# soft-delete window:
# AUDIT_RETENTION_DAYS=365

# Prisma pool size per API process (TASK-153; 0 = Prisma's default). Keep
# replicas × this under the server's max_connections. Queries at or above
# SLOW_QUERY_MS are logged (0 = off):
# DB_CONNECTION_LIMIT=10
# SLOW_QUERY_MS=200

# Tuning for the bundled Postgres container (backend/docker-compose.yml):
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_WORK_MEM=8MB
# POSTGRES_MAX_CONNECTIONS=100

# Redis for BullMQ queues, realtime fan-out, cache invalidation and the shared
# rate-limit counters. Optional for a single API process — unset keeps the
# in-process queue and per-process limits. Multiple API replicas (TASK-200.12)
# require it for consistent limits, SSE fan-out and prompt cache invalidation.
# The dev redis comes from docker-compose.
# REDIS_URL="redis://localhost:6379"

# Public base URL of the UI (TASK-54: OAuth login). Builds the provider
# callback URLs that must be registered verbatim in the Google/Yandex
# consoles, and the post-login redirect target. In production nginx serves
# the UI and API from one origin, so set it to that origin.
PUBLIC_ORIGIN="http://localhost:5173"

# Master-panel credential encryption (TASK-52; derived from JWT_SECRET when
# unset):
# SETTINGS_SECRET="openssl rand -hex 32"
