// Janosik schema — full §7.3 (TASK-25): normalized kanban board, membership
// roles, soft-delete flags and per-entity versions from day one.
//
// Conventions (ROADMAP §7.0):
// - Every deletable entity carries `deletedAt` (soft-delete); cascades are
//   app-level flag propagation, never DB `onDelete: Cascade` (default
//   RESTRICT keeps referential integrity until the purge job runs).
// - Every entity holding editable text carries `version` for `ifMatch` → 409
//   undo-conflict handling: Board, Column, Card, Label, Checklist, ChecklistItem.
// - `@db.VarChar(N)` bounds mirror `LIMITS` from `@janosik/shared` (Prisma
//   cannot import TS constants — keep these numbers in sync manually).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String                  @id @default(cuid())
  email            String                  @unique
  // Nullable (TASK-54): OAuth-only accounts have no local password — login
  // rejects them until one is adopted via the password change.
  passwordHash     String?
  displayName      String?
  avatarColor      String? // USER_AVATAR_COLORS key (TASK-36.1); null → id-hash default
  avatarPath       String? // TASK-47 stored avatar image name; null → initials
  disabledAt       DateTime? // master block (TASK-36); login/refresh → 403
  emailVerifiedAt  DateTime? // TASK-53; null → the address is not confirmed yet
  // TASK-72: opt-out for scheduled digests/reminders (default on).
  notifyDigest     Boolean                 @default(true)
  // TASK-166.9: opt-out for immediate attention e-mails (approvals, blocked
  // agents, expired claims, quota warnings). The in-app attention inbox is
  // always written; this switch only controls e-mail delivery.
  notifyAttention  Boolean                 @default(true)
  // Announcement localization: the canonical language for the UI, banners and
  // email. Nullable for accounts created before the feature — treated as "not
  // chosen yet" and adopted from the current UI language on the next sign-in.
  locale           String?
  createdAt        DateTime                @default(now())
  memberships      BoardMember[]
  invitedMembers   BoardMember[]           @relation("BoardMemberInviter")
  activity         Activity[]
  comments         Comment[]
  commentRevisions CommentRevision[]
  apiTokens        ApiToken[]
  commands         Command[]
  refreshTokens    RefreshToken[]
  attachments      Attachment[]
  assignedCards    Card[]                  @relation("CardAssignee")
  emailChanges     EmailChangeCode[]
  verifications    EmailVerificationCode[]
  passwordReset    PasswordResetToken?
  oauthIdentities  OAuthIdentity[]
  dismissals       AnnouncementDismissal[]

  @@index([createdAt]) // admin users period filter
}

model OAuthIdentity {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String

  @@unique([userId, provider])
}

model PasswordResetToken {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime

  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  revokedAt DateTime? // rotation; reuse of a revoked token revokes all user sessions
  createdAt DateTime  @default(now()) // session review page (TASK-43)
  // Session provenance (TASK-65): captured at login so support can see where
  // a session came from. Nullable — sessions minted before the column exists.
  ip        String?
  userAgent String?
  // Rotation family (PR #250 review): every token minted by rotating the
  // same login shares it, so logout can revoke the whole chain atomically.
  // Nullable — legacy rows predate the column.
  familyId  String?

  @@index([userId, createdAt])
  @@index([expiresAt]) // dead-session sweep (TASK-148)
  @@index([revokedAt]) // dead-session sweep (TASK-148)
  @@index([familyId, revokedAt])
}

// Email change (TASK-51) — double opt-in: the user proves the current
// password, a 6-digit code goes to the NEW address and must be presented
// back before `User.email` moves. Mirrors the RefreshToken discipline: only
// the sha256 of the code is stored, one live row per user (a new request
// deletes the previous one), single-use, short TTL, and an attempts counter
// so a code cannot be brute-forced inside its lifetime.
model EmailSettings {
  // Singleton row (id is always "singleton") — the master-panel editable
  // mail transport (TASK-52). Overrides the SMTP_* env bootstrap at runtime.
  id          String    @id
  provider    String // gmail | yandex | mailru | brevo | sendgrid | custom | mailpit
  host        String
  port        Int
  secure      Boolean   @default(false)
  from        String
  username    String
  passwordEnc String? // AES-256-GCM (secret-box); never leaves the backend
  enabled     Boolean   @default(false)
  lastTestAt  DateTime?
  lastTestOk  Boolean?
  lastError   String?
  updatedBy   String?
  updatedAt   DateTime  @updatedAt
}

model EmailChangeCode {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  newEmail   String
  codeHash   String    @unique
  attempts   Int       @default(0) // wrong guesses; ≥ MAX → row deleted
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

// Registration email confirmation (TASK-53): the same discipline as the
// email-change codes — only the sha256 of the code is stored, one live row
// per user, single-use, short TTL, and an attempts counter so a code cannot
// be brute-forced inside its lifetime.
model EmailVerificationCode {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  codeHash   String    @unique
  attempts   Int       @default(0) // wrong guesses; ≥ MAX → row deleted
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

// OAuth login (TASK-54) — one row per external provider (the id IS the
// provider id: "google" | "yandex"), editable from the master panel. The
// client secret is encrypted at rest with secret-box (AES-256-GCM) and
// never leaves the backend, like EmailSettings.passwordEnc.
model OAuthProviderSettings {
  id              String   @id
  clientId        String
  clientSecretEnc String? // AES-256-GCM (secret-box); never leaves the backend
  enabled         Boolean  @default(false)
  updatedBy       String?
  updatedAt       DateTime @updatedAt
}

// Global API rate limit (TASK-57) — singleton row (id is always "singleton")
// editable from the master panel. Overrides the THROTTLE_LIMIT env default at
// runtime; the throttler reads it per request, so changes need no restart.
model ThrottleSettings {
  id        String   @id
  limit     Int
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Master-panel demo runner (TASK-57). One row per run; `manifest` records the
// exact ids reserved before provisioning, so `stop`
// deletes precisely those rows — cleanup never guesses from names.
model DemoRun {
  id        String    @id @default(cuid())
  boardId   String
  status    String    @default("running") // running | stopping | finished | stopped
  manifest  Json
  // TASK-69: cards that reached the last column, updated by the demo job.
  progress  Int       @default(0)
  startedBy String // master email (snapshot)
  startedAt DateTime  @default(now())
  stoppedAt DateTime?

  @@index([status, startedAt]) // "is a demo running" lookups (TASK-92)
}

model Board {
  id                 String        @id @default(cuid())
  title              String        @db.VarChar(100) // LIMITS.boardTitle
  columnStyle        String? // TASK-164: column accent shape; null = signature
  // Admin-configured card workflow (BoardWorkflow in @janosik/shared).
  // NULL = no process, every move allowed — the legacy behaviour.
  workflow           Json?
  // TASK-166: board-level agent policy and pause state. `agentPolicy = NULL`
  // means the safe defaults from the ADR (§6.3); the version is a separate
  // CAS token and never mixes with `Board.version`.
  agentPolicy        Json?
  agentPolicyVersion Int           @default(1)
  agentsPausedAt     DateTime?
  agentsPausedBy     String?
  agentsPauseReason  String?
  archivedAt         DateTime?
  deletedAt          DateTime? // soft-delete (§7.0)
  version            Int           @default(0) // ifMatch → 409 (title editable)
  // TASK-200.6: monotonic content revision for the full board aggregate.
  // Commands advance it through the Board row; direct Card/Comment/Attachment/
  // claim writes advance it through database triggers. Unlike `seq` it never
  // moves backwards when old commands are swept.
  aggregateRevision  BigInt        @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  members            BoardMember[]
  columns            Column[]
  labels             Label[]
  cardLinks          CardLink[]
  activity           Activity[]
  commands           Command[]
  shares             BoardShare[]

  @@index([deletedAt]) // board purge sweep (TASK-148)
}

// Public read-only board link (TASK-58, §7.9). A share is its own entity —
// token + mode + privacy flags + TTL + revoke — never a "public" flag on the
// board itself, so a link can be handed out, embedded and revoked on its own.
// `mode` "snapshot" freezes a BoardEnvelope in `snapshot` (survives the
// source board being deleted); "live" reads the board as it is and dies with
// it. The token is stored as-is (it must round-trip into a URL/embed) and its
// 128-bit entropy + `expiresAt` + `revokedAt` + rate limit are the guard.
model BoardShare {
  id                     String                      @id @default(cuid())
  token                  String                      @unique // 128-bit base64url
  // Snapshot shares deliberately outlive their source board (TASK-58,
  // TASK-156): deleting the board detaches the frozen copy instead of
  // cascading it away. Live shares are revoked before the board goes.
  board                  Board?                      @relation(fields: [boardId], references: [id], onDelete: SetNull)
  boardId                String?
  mode                   String                      @default("snapshot") // snapshot | live
  snapshot               Json? // frozen board and roster
  snapshotVersion        Int? // board seq at snapshot time ("taken at")
  snapshotTakenAt        DateTime?
  // Null on legacy shares, which read retained source rows with a time cutoff.
  snapshotHasComments    Boolean?
  snapshotHasAttachments Boolean?
  title                  String? // owner-side label for the share list
  includeComments        Boolean                     @default(true)
  includeAttachments     Boolean                     @default(false)
  expiresAt              DateTime? // TTL; null = no expiry
  revokedAt              DateTime? // manual revoke
  createdBy              String // userId (board) or admin email (panel/demo)
  views                  Int                         @default(0)
  lastViewedAt           DateTime?
  createdAt              DateTime                    @default(now())
  snapshotBlobs          BoardShareSnapshotBlob[]
  snapshotComments       BoardShareSnapshotComment[]

  @@index([boardId])
  @@index([createdBy])
  @@index([expiresAt]) // TTL sweep (TASK-148)
  @@index([revokedAt]) // revoked-share sweep (TASK-148)
}

// Keeps snapshot copies in the uploads volume alive until the share is
// refreshed or removed. No reference to the original attachment or board.
model BoardShareSnapshotBlob {
  storedName   String     @id
  share        BoardShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  shareId      String
  attachmentId String?
  cardId       String?
  createdAt    DateTime?
  isInline     Boolean?
  metadata     Json?

  @@unique([shareId, attachmentId])
  @@index([shareId, cardId, isInline, createdAt])
  @@index([shareId])
}

// Public-safe frozen comments are paged by card without loading the board or
// comments on other cards. IDs reference only the share, never source rows.
model BoardShareSnapshotComment {
  share     BoardShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  shareId   String
  id        String
  cardId    String
  createdAt DateTime
  payload   Json

  @@id([shareId, id])
  @@index([shareId, cardId, createdAt, id], map: "BoardShareSnapshotComment_page_idx")
}

// Independent of the share and board rows so history survives their removal.
model BoardShareAuditLog {
  id             String   @id @default(cuid())
  shareId        String
  boardId        String
  actorId        String
  actorType      String
  // TASK-166: token/session attribution so two PATs of one account are
  // distinguishable. Nullable — every row written before the migration.
  apiTokenId     String?
  agentSessionId String?
  agentName      String?
  action         String
  details        Json
  createdAt      DateTime @default(now())

  @@index([boardId, createdAt])
  @@index([shareId, createdAt])
}

model BoardMember {
  id          String    @id @default(cuid())
  board       Board     @relation(fields: [boardId], references: [id])
  boardId     String
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  role        Role      @default(MEMBER) // ADMIN | MEMBER | VIEWER
  expiresAt   DateTime? // VIEWER on a time budget; expired → 403
  // Opt-in invitations (TASK-35 addendum): the row is created as a pending
  // invitation and confers NO access until the invitee accepts. `null` =
  // pending; a timestamp = accepted at that moment.
  acceptedAt  DateTime?
  invitedBy   User?     @relation("BoardMemberInviter", fields: [invitedById], references: [id])
  invitedById String?
  createdAt   DateTime  @default(now())

  @@unique([boardId, userId])
  @@index([userId]) // "my boards"
  @@index([userId, acceptedAt]) // pending invitation feed
  @@index([expiresAt]) // lapsed-invitation sweep (TASK-148)
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

// Master tiers (TASK-36). OWNER manages masters from the panel; OPERATOR
// has full data access but cannot create or block masters, so a compromised
// operator session cannot escalate privileges or lock the owner out.
enum AdminRole {
  OWNER
  OPERATOR
}

model ApiToken {
  id                     String    @id @default(cuid())
  user                   User      @relation(fields: [userId], references: [id])
  userId                 String
  name                   String // "CI", "integration …"
  tokenHash              String    @unique // shown once, only the hash is stored
  // TASK-157 scopes: a token may be limited to one board and/or to reads,
  // and carry its own request-per-minute budget. Null = no restriction.
  boardId                String? // board this token is scoped to; null = all
  readOnly               Boolean   @default(false) // true = reads only
  rateLimitPerMinute     Int? // per-token rate limit; null = global only
  // TASK-166 identity: preset (observer|worker|reviewer|admin) plus the
  // explicit trusted-CI escape hatch. `readOnly` still wins and yields an
  // effective observer. Legacy rows are backfilled by the 166.1 migration.
  scopePreset            String    @default("worker")
  trustedCi              Boolean   @default(false)
  // Two independent pause sources (TASK-166): resume-all clears only the
  // stop-all stamp; an individual pause survives it.
  individualPausedAt     DateTime?
  individualPausedBy     String?
  individualPausedReason String?
  stopAllPausedAt        DateTime?
  stopAllPausedBy        String?
  lastUsedAt             DateTime?
  expiresAt              DateTime?
  revokedAt              DateTime?
  createdAt              DateTime  @default(now())

  @@index([userId])
  @@index([userId, individualPausedAt])
  @@index([userId, stopAllPausedAt])
}

// TASK-200.11: the command log is range-partitioned by `createdAt` (one
// parent + monthly partitions + a default partition, see the migrations
// `20261123130000_task_200_11_command_log_partitioning`,
// `20261123131000_task_200_11_command_details_side_table`,
// `20261123132000_task_200_11_command_key_registry`,
// `20261123133000_task_200_11_safe_partition_drop` and
// `20261123134000_task_200_11_command_key_move`). PostgreSQL requires
// every unique constraint on a partitioned table to contain the partition
// key, so the table primary key is `(id, createdAt)` rather than `id`.
// Global commandId uniqueness — the old `Command_pkey` guarantee — is restored
// by the unpartitioned `CommandKey` registry: a BEFORE INSERT trigger claims
// the id and a unique violation aborts a cross-board collision. Same-board
// retries are still resolved inside the serialized board-write transaction
// before an insert is attempted.
model Command {
  id             String // = client commandId → idempotent retries
  board          Board    @relation(fields: [boardId], references: [id])
  boardId        String
  actor          User     @relation(fields: [actorId], references: [id])
  actorId        String
  actorType      String   @default("human") // TASK-157: human | agent
  // TASK-166 attribution: the API token/session/run that issued the command,
  // plus the token-name snapshot. Null for browser sessions and legacy rows.
  apiTokenId     String?
  agentSessionId String?
  runId          String?
  agentName      String?
  seq            BigInt   @default(autoincrement()) // monotonic board version; ?since=
  type           String // BoardAction type
  payload        Json // whole action (deterministic — TASK-21.7a)
  result         Json // first apply result {seq, versions}
  touches        String[] // ["card:c1","column:col-2"] — touched entities
  createdAt      DateTime @default(now())

  @@id([id, createdAt])
  @@index([boardId, seq])
  // GIN (not B-tree) so the per-entity feed's `touches: { has: … }` lookup is
  // an index scan, not a seq scan (TASK-92). It is created on every partition.
  @@index([touches], type: Gin)
  // B-7: the retention sweep (`createdAt < cutoff`) and the admin metrics
  // (24h/7d counts, per-day series) range-scan by time; the per-board
  // history/time-window reads use the composite.
  @@index([createdAt])
  @@index([boardId, createdAt, seq])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
  @@index([apiTokenId, createdAt])
  @@index([agentSessionId, createdAt])
  @@index([runId])
}

/**
 * TASK-200.11 — global commandId registry. Unpartitioned on purpose: a unique
 * index on a partitioned table must contain the partition key, which is exactly
 * what allowed the same client id on two boards after the swap. The registry
 * has the old `id` primary key and is populated by a BEFORE INSERT trigger on
 * `Command`; the deferred Command delete trigger does not release it. Orphan
 * keys are deleted by the maintenance sweep in bounded `NOT EXISTS Command`
 * batches (the registry is large and unpartitioned, so retention must not do
 * an unbounded month delete here). `boardId` lets detail reads and purge paths
 * be scoped even if an old caller only has the id; `createdAt` drives the
 * orphan sweep. The upsert accepts the same board so a partition-moving
 * `createdAt` UPDATE can reuse its key; cross-board uniqueness is still
 * DB-enforced, while a same-board duplicate of a live id is rejected by the
 * application pre-check (a raw same-board INSERT is not blocked).
 */
model CommandKey {
  id        String   @id
  boardId   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/**
 * TASK-200.11 — heavy command display snapshots (the "from → to" diff frozen
 * at apply time by `commandDetails`). One row per command that has a diff;
 * partition key = command `createdAt`, so retention drops the pair together.
 * There is deliberately no FK to `Command` or `CommandKey`: a partitioned FK
 * to `Command` blocks monthly `DROP TABLE`, and a cascade to the registry
 * destroys the snapshot during a cross-partition `createdAt` move. `boardId`
 * scopes every read; the deferred Command delete trigger removes the row on a
 * real delete, and the move trigger rewrites `createdAt` with the command.
 */
model CommandDetail {
  commandId String
  boardId   String
  createdAt DateTime @default(now())
  data      Json

  @@id([commandId, createdAt])
  @@index([boardId, commandId])
}

// TASK-200.11: pre-images are partitioned by the command's `createdAt` (the
// writer passes the explicit clock now, so a pre-image cannot cross a month
// boundary away from its command). Retention can drop a month without a
// per-row delete; the preimage-first delete order still protects a partial
// month.
model CommandPreimage {
  commandId String
  boardId   String
  runId     String?
  data      Json
  createdAt DateTime @default(now())

  @@id([commandId, createdAt])
  @@index([boardId, runId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// TASK-166 agent control. These tables store ids as scalars without FKs
// (ADR §6.1): a record must survive soft-delete and purge, and a cascade must
// never erase audit before retention.
// ---------------------------------------------------------------------------

model AgentSession {
  id                       String    @id @default(cuid())
  userId                   String
  apiTokenId               String
  boardId                  String
  name                     String?   @db.VarChar(100)
  clientName               String?   @db.VarChar(100)
  model                    String?   @db.VarChar(100)
  status                   String    @default("active")
  // active|idle|waiting_approval|completed|failed|cancelled
  currentCardId            String?
  currentRunId             String?
  startedAt                DateTime  @default(now())
  lastHeartbeatAt          DateTime  @default(now())
  lastHeartbeatPublishedAt DateTime?
  endedAt                  DateTime?
  endReason                String?
  pausedAt                 DateTime?
  pausedBy                 String?
  pausedReason             String?
  summary                  String?   @db.Text

  @@index([apiTokenId, status])
  @@index([boardId, status, lastHeartbeatAt])
  @@index([boardId, startedAt])
  @@index([userId, startedAt])
  @@index([lastHeartbeatAt])
  @@index([endedAt])
}

model AgentRun {
  id             String    @id @default(cuid())
  boardId        String
  apiTokenId     String?
  agentSessionId String?
  actorId        String
  kind           String // batch|plan|single|revert
  status         String    @default("applied") // applied|reverted
  clientRunId    String?
  planHash       String?
  approvalId     String?   @unique
  commandCount   Int       @default(0)
  firstSeq       BigInt?
  lastSeq        BigInt?
  revertsRunId   String?
  createdAt      DateTime  @default(now())
  appliedAt      DateTime  @default(now())
  revertedAt     DateTime?

  @@unique([boardId, clientRunId])
  @@index([boardId, createdAt])
  @@index([agentSessionId, createdAt])
  @@index([apiTokenId, createdAt])
}

model ApprovalRequest {
  id                 String    @id @default(cuid())
  boardId            String
  cardId             String?
  requestedBy        String // PAT owner userId
  requestedByTokenId String
  agentSessionId     String?
  kind               String // destructive|done|custom
  actionType         String // BoardAction.type | "batch" | operation
  summary            String    @db.VarChar(500)
  risk               String    @default("medium") // low|medium|high
  plan               Json
  planHash           String
  status             String    @default("pending")
  // pending|approved|rejected|expired|cancelled|consumed
  expiresAt          DateTime
  decidedBy          String?
  decidedAt          DateTime?
  decisionComment    String?   @db.Text
  runId              String?
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([boardId, status, createdAt])
  @@index([boardId, agentSessionId, status])
  @@index([requestedByTokenId, status])
  @@index([expiresAt, status])
  @@index([status, decidedAt])
  @@index([status, consumedAt])
  @@index([planHash])
}

model SecurityAuditLog {
  id             String   @id @default(cuid())
  userId         String
  actorId        String
  actorType      String   @default("human") // human|agent|admin
  apiTokenId     String?
  agentSessionId String?
  action         String
  targetType     String?
  targetId       String?
  details        Json?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  scope          String // create_board|import_boards|create_share|upload_attachment|<operation>
  actorKey       String // "user:<id>" or "token:<id>"
  key            String
  requestHash    String
  status         String   @default("in_progress") // in_progress|completed
  responseStatus Int?
  responseBody   Json?
  resourceId     String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([scope, actorKey, key])
  @@index([expiresAt])
}

model Column {
  id          String    @id // client-provided id
  board       Board     @relation(fields: [boardId], references: [id])
  boardId     String
  title       String    @db.VarChar(100)
  wipLimit    Int? // TASK-13
  accentType  String? // TASK-164: color | gradient
  accentValue String?
  position    Int
  deletedAt   DateTime? // soft-delete (§7.0)
  version     Int       @default(0) // ifMatch → 409 (§7.0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cards       Card[]

  @@index([boardId, position])
  @@index([boardId, id]) // board-scoped comments join
  @@index([deletedAt]) // purge sweep (TASK-148)
}

model Card {
  id                   String       @id
  column               Column       @relation(fields: [columnId], references: [id])
  columnId             String
  title                String       @db.VarChar(300) // LIMITS.cardTitle
  description          String?      @db.Text // markdown, LIMITS.description
  // TASK-200.2: stored character length so a ready summary can expose
  // `descriptionChars` without detoasting the text. Maintained by the
  // Card_description_length trigger (migration 20261123110000).
  descriptionLength    Int          @default(0)
  coverType            String? // color | gradient
  coverValue           String?
  dueDate              DateTime?
  priority             String? // TASK-45: blocker|highest|high|medium|low|lowest (null = medium)
  assigneeId           String? // TASK-49 Jira-style assignee; null = unassigned
  assignee             User?        @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  claimedBy            String? // TASK-157 agent claim holder (user id); null = unclaimed
  // TASK-166: the token/session that actually holds the claim. Filled by the
  // server from the principal; the CLAIM_CARD payload cannot set them.
  claimedByTokenId     String?
  claimedBySessionId   String?
  leaseUntil           DateTime? // TASK-157 claim lease expiry; null = unclaimed
  acceptanceCriteria   String[] // TASK-157 machine-readable task contract (empty = unset)
  definitionOfDone     String[] // TASK-157 machine-readable task contract (empty = unset)
  archivedAt           DateTime? // TASK-18.1: card archive
  // TASK-165 review: the column an archived card came from, so unarchive can
  // enforce the workflow from that column. Kept after a column delete (the
  // internal orphan repoint only changes `columnId`).
  archivedFromColumnId String?
  deletedAt            DateTime? // soft-delete (§7.0)
  version              Int          @default(0) // ifMatch → 409 (§7.0)
  position             Int
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  lastActorId          String? // TASK-36 "who changed it" denormalization
  // TASK-47 denormalized live-attachment count (card-face badge); kept in
  // step by the attachments service, outside the command loop.
  attachmentCount      Int          @default(0)
  labels               CardLabel[]
  checklists           Checklist[]
  linksFrom            CardLink[]   @relation("CardLinkFrom")
  linksTo              CardLink[]   @relation("CardLinkTo")
  activity             Activity[]
  comments             Comment[]
  attachments          Attachment[]

  @@index([columnId, position])
  // TASK-181.7 admin list filters and live card counts.
  @@index([columnId, id]) // board-scoped comments join
  @@index([columnId, deletedAt])
  @@index([id, deletedAt])
  @@index([createdAt])
  @@index([priority, updatedAt])
  @@index([attachmentCount, updatedAt])
  @@index([assigneeId]) // admin user-detail "assigned cards" (TASK-49)
  @@index([claimedByTokenId])
  @@index([claimedBySessionId])
  @@index([leaseUntil]) // lapsed-claim sweep (TASK-157)
  @@index([dueDate]) // scheduled due reminders (TASK-72, TASK-92)
  @@index([deletedAt]) // purge sweep (TASK-148)
}

// Card links (TASK-46). Directional: `fromCard` holds the row and "blocks"
// (or "relates to" / "duplicates") `toCard`. Rows are immutable (no text to
// edit, hence no version) — undo/redo flip `deletedAt`, exactly like the
// client reducer adds/removes the row on the source card. Rows pointing at
// a soft-deleted card are kept: the aggregate skips them with the card, and
// restoring the card revives the link the way the client's undo does.
model CardLink {
  id         String    @id // client-provided link id
  board      Board     @relation(fields: [boardId], references: [id])
  boardId    String
  fromCard   Card      @relation("CardLinkFrom", fields: [fromCardId], references: [id])
  fromCardId String
  toCard     Card      @relation("CardLinkTo", fields: [toCardId], references: [id])
  toCardId   String
  type       String // blocks | relates_to | duplicates
  position   Int       @default(0) // order within the source card's `links`
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  // No `version` column on purpose: links are last-write-wins (§7.0) — the
  // only commands carrying `ifMatch` preconditions are text edits, and a
  // link row has no text. `Card.version` already covers the card it hangs on.

  @@index([boardId])
  @@index([fromCardId, position])
  @@index([toCardId])
  @@index([createdAt]) // admin list order and createdAt filters
  @@index([type, createdAt]) // admin type filters
  @@index([boardId, type, createdAt]) // admin type + board
  @@index([deletedAt]) // purge sweep (TASK-148)
}

model Label {
  id        String      @id
  board     Board       @relation(fields: [boardId], references: [id])
  boardId   String
  name      String      @db.VarChar(50) // LIMITS.labelName
  color     String // one of the 14 palette colors
  // Order in `board.labels` (TASK-27). §7.3 omitted it, but the aggregate
  // and the reducer both treat the label list as ordered (RESTORE_LABEL
  // carries an insertion `index`), so the order must be stored.
  position  Int         @default(0)
  deletedAt DateTime? // soft-delete (§7.0)
  version   Int         @default(0) // ifMatch → 409 (§7.0)
  cards     CardLabel[]

  @@index([boardId, position])
  @@index([deletedAt]) // purge sweep (TASK-148)
}

model CardLabel {
  card     Card   @relation(fields: [cardId], references: [id])
  cardId   String
  label    Label  @relation(fields: [labelId], references: [id])
  labelId  String
  position Int    @default(0)

  @@id([cardId, labelId])
  @@index([labelId]) // label cascade
  @@index([labelId, cardId]) // admin labels card counts
}

model Checklist {
  id        String          @id
  card      Card            @relation(fields: [cardId], references: [id])
  cardId    String
  title     String          @db.VarChar(100)
  position  Int
  deletedAt DateTime? // soft-delete (§7.0)
  version   Int             @default(0) // ifMatch → 409 (title editable)
  items     ChecklistItem[]

  @@index([cardId, position])
  @@index([deletedAt]) // purge sweep (TASK-148)
}

model ChecklistItem {
  id          String    @id
  checklist   Checklist @relation(fields: [checklistId], references: [id])
  checklistId String
  text        String    @db.VarChar(500)
  done        Boolean   @default(false)
  position    Int
  deletedAt   DateTime? // soft-delete (§7.0)
  version     Int       @default(0) // ifMatch → 409 (text editable)

  @@index([checklistId, position])
  @@index([deletedAt]) // purge sweep (TASK-148)
}

// Boundary with the Command log (decided with variant B):
//   Command  — everything that is a `BoardAction` (column/card/label/checklist
//              create/edit/move/archive). Card activity events are derived
//              FROM it, nothing to duplicate here.
//   Activity — only what the reducer action is NOT and therefore cannot live
//              in Command (payload is typed as BoardAction): membership
//              (invite / role change / removal) and comments.
// Feed = merge of both sources by `createdAt` (composite cursor).
model Activity {
  id             String   @id @default(cuid())
  board          Board    @relation(fields: [boardId], references: [id])
  boardId        String
  card           Card?    @relation(fields: [cardId], references: [id])
  cardId         String?
  type           String // member_invited | member_role_changed | member_removed | comment_added
  // TASK-185.2: typed comment link for `comment_*` events. No FK — comments
  // are soft-deleted and a tombstone must survive a hard purge; the writer
  // fills it for every new event and the migration backs it from legacy
  // `details.commentId`. `comment_updated` reads are additionally guarded by
  // a live comment/card/column/board EXISTS predicate.
  commentId      String?
  actor          User     @relation(fields: [actorId], references: [id])
  actorId        String // now a real user
  actorType      String   @default("human") // TASK-157: human | agent
  // TASK-166 attribution, same shape as Command.
  apiTokenId     String?
  agentSessionId String?
  runId          String?
  agentName      String?
  details        Json? // snapshot details (email, role, …)
  createdAt      DateTime @default(now())

  @@index([boardId, createdAt])
  @@index([cardId, createdAt])
  @@index([commentId])
  @@index([createdAt]) // activity retention sweep (TASK-148)
  @@index([actorId, createdAt])
  @@index([type, createdAt])
  @@index([apiTokenId, createdAt])
  @@index([agentSessionId, createdAt])
  @@index([runId])
}

/// TASK-185.1: why a comment's revision chain cannot be shown as complete.
/// When several apply, the most severe wins:
/// writer_gap > gdpr_erase > revision_limit > legacy_cutover.
enum CommentHistoryIncompleteReason {
  legacy_cutover
  revision_limit
  gdpr_erase
  writer_gap
}

/// TASK-185.1: what produced an immutable comment revision. `system` is
/// reserved for future automatic rewrites; current paths pass the real
/// initiator as `author_edit` or `attachment_deleted`.
enum CommentRevisionCause {
  author_edit
  attachment_deleted
  system
}

model Comment {
  id                            String                          @id @default(cuid())
  card                          Card                            @relation(fields: [cardId], references: [id])
  cardId                        String
  author                        User                            @relation(fields: [authorId], references: [id])
  authorId                      String
  text                          String                          @db.Text // LIMITS.comment (10000) — plain text
  kind                          String                          @default("note") // TASK-157 (D10): note|status|question|blocker|evidence|handoff
  // TASK-166 attribution: comments live outside the command log, so the
  // actor identity is stored on the row itself.
  actorType                     String                          @default("human") // human|agent
  apiTokenId                    String?
  agentSessionId                String?
  agentName                     String?
  deletedAt                     DateTime? // soft-delete (§7.0)
  editedAt                      DateTime? // TASK-176.2: last text edit; null = never edited
  // TASK-185.1 edit history. `historyCutoverAt` fences revisions: a real
  // revision timestamp must be strictly after it, and a row created after
  // the migration gets it from the DB default at insert. `editedAt` and the
  // verified pair are written together with one revision timestamp so a
  // writer from an older release can be detected by comparing them.
  lastRevisionNumber            Int                             @default(0)
  historyCutoverAt              DateTime                        @default(now())
  historyVerifiedEditedAt       DateTime?
  historyVerifiedRevisionNumber Int?
  historyIncompleteReason       CommentHistoryIncompleteReason?
  revisions                     CommentRevision[]
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt

  @@index([cardId, createdAt])
  @@index([authorId, createdAt]) // admin author and combined filters
  @@index([kind, createdAt]) // admin kind and combined filters
  @@index([createdAt]) // admin period filter
  @@index([deletedAt]) // purge sweep (TASK-148)
  @@index([apiTokenId, createdAt])
  @@index([agentSessionId, createdAt])
}

/// TASK-185.1 immutable comment snapshot. A row is written exactly once per
/// real text edit; `(commentId, revisionNumber)` is unique and numbers stay
/// monotonic across trimming and GDPR erase. Children are cleaned explicitly
/// before a comment/user is hard-deleted (the FKs stay RESTRICT).
model CommentRevision {
  id             String               @id @default(cuid())
  comment        Comment              @relation(fields: [commentId], references: [id], onDelete: Restrict)
  commentId      String
  revisionNumber Int
  beforeText     String               @db.Text
  afterText      String               @db.Text
  createdAt      DateTime             @default(now())
  editor         User?                @relation(fields: [editorId], references: [id], onDelete: Restrict)
  editorId       String?
  actorType      String               @default("human") // human|agent
  apiTokenId     String?
  agentSessionId String?
  agentName      String?
  cause          CommentRevisionCause

  @@unique([commentId, revisionNumber])
  @@index([editorId]) // GDPR erase finds every revision the user edited
}

// File attachments (TASK-47) — self-hosted blobs on the local disk under
// `UPLOAD_DIR`. Like comments, they live OUTSIDE the command loop (no undo,
// no board JSON), so rows are version-free and soft-deleted like comments.
// `storedName` is a server-generated name — the client's `fileName` is
// metadata only and must never be used as a filesystem path.
model Attachment {
  id                  String    @id @default(cuid())
  card                Card      @relation(fields: [cardId], references: [id])
  cardId              String
  boardId             String
  fileName            String
  storedName          String    @unique
  mimeType            String
  // TASK-181.7: indexed MIME family for the admin filter. A database trigger
  // keeps it in step with mimeType for rows written outside the upload service.
  mimeFamily          String    @default("other")
  sizeBytes           Int // ≤ LIMITS.attachmentSize (25 MB)
  uploadedBy          User      @relation(fields: [uploadedById], references: [id])
  uploadedById        String
  // TASK-166 attribution for the "own upload" rule: two PATs of one owner
  // are distinguishable. Legacy rows stay NULL and fall back to userId.
  uploadedByTokenId   String?
  uploadedBySessionId String?
  // Inline media (TASK-48 paste): embedded into a description/comment body
  // via its `content` URL instead of the attachment list — hidden from
  // `list()` and excluded from the card-face `attachmentCount`.
  isInline            Boolean   @default(false)
  // Description uploads remain available for undo and snapshots when detached.
  descriptionEmbed    Boolean   @default(false)
  descriptionDetached Boolean   @default(false)
  // TASK-50 video "ужиматор": video uploads re-encode to a compact H.264
  // MP4 in a background job (original kept until the encode succeeds).
  // `none` — not a video (or transcode disabled), `pending` — queued/
  // running, `done` — `storedName` now points at the MP4, `failed` —
  // the original stays and plays as-is.
  transcodeStatus     String    @default("none")
  // TASK-70 media derivatives: an ffmpeg thumbnail for images / poster frame
  // for videos, generated in the background (`media` queue) and served by
  // `/attachments/:id/thumbnail|poster`. `derivativeStatus` mirrors the
  // transcode states (none/pending/done/failed).
  thumbnailName       String?
  posterName          String?
  derivativeStatus    String    @default("none")
  deletedAt           DateTime? // soft-delete (§7.0)
  createdAt           DateTime  @default(now())

  @@index([cardId, createdAt])
  @@index([boardId, createdAt]) // board-scoped moderation
  @@index([createdAt]) // admin period filter
  @@index([uploadedById, createdAt]) // admin uploader filter
  @@index([mimeFamily, createdAt]) // admin MIME family filter
  @@index([transcodeStatus, createdAt]) // admin transcode filter
  @@index([deletedAt]) // purge sweep (TASK-92)
  @@index([deletedAt, transcodeStatus]) // boot recovery (TASK-92)
  @@index([deletedAt, derivativeStatus]) // media boot recovery (TASK-92)
  @@index([uploadedByTokenId])
  @@index([uploadedBySessionId])
}

// ---------------------------------------------------------------------------
// Platform operator — the "master account" (TASK-36).
//
// Deliberately NOT a `User`: it never appears in the public registration,
// never shows up in user listings and can never be a board member. The only
// way to create one is the `npm run admin:create` CLI on the server; the
// admin panel authenticates through its own JWT audience, its own cookie
// path and its own refresh-token table, so a stolen user session cannot
// reach a single `/admin` route and vice versa.
// ---------------------------------------------------------------------------
// Background data export (TASK-71): a large user's GDPR bundle is built by
// the `exports` queue, stored as a file under UPLOAD_DIR and handed out by a
// TTL'd link instead of blocking the request.
model DataExport {
  id         String   @id @default(cuid())
  userId     String
  userEmail  String
  status     String   @default("pending") // pending | ready | failed
  filename   String
  storedName String?
  sizeBytes  Int?
  error      String?
  createdBy  String // master email (snapshot)
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt]) // expiry sweep (TASK-92)
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  displayName   String?
  // Tier of this master (TASK-36): OWNER | OPERATOR — see `enum AdminRole`.
  role          AdminRole @default(OPERATOR)
  failedLogins  Int       @default(0) // lockout counter
  lockedUntil   DateTime? // set after N consecutive failures
  disabledAt    DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  // Master 2FA (TASK-65): a TOTP secret encrypted at rest (secret-box) and
  // the on/off switch. When `totpEnabled`, login additionally requires a
  // 6-digit code. `ipAllowlist` is a CSV of IPs/CIDRs; null = unrestricted.
  totpSecretEnc String?
  totpEnabled   Boolean   @default(false)
  ipAllowlist   String?

  refreshTokens AdminRefreshToken[]
  auditLogs     AdminAuditLog[]
}

model AdminRefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 of the raw token, never the token
  admin     AdminUser @relation(fields: [adminId], references: [id])
  adminId   String
  expiresAt DateTime
  revokedAt DateTime? // rotation; reuse of a revoked token kills all sessions
  createdAt DateTime  @default(now())
  // Session provenance (TASK-65): captured at login for the sessions view.
  ip        String?
  userAgent String?

  @@index([adminId])
  @@index([expiresAt]) // dead-session sweep (TASK-148)
  @@index([revokedAt]) // dead-session sweep (TASK-148)
}

// Accountability layer (§ admin panel best practices, TASK-36): every login
// attempt and every mutation lands here. `adminEmail` is a snapshot so the
// trail stays readable even for unknown-email login attempts.
model AdminAuditLog {
  id             String     @id @default(cuid())
  admin          AdminUser? @relation(fields: [adminId], references: [id])
  adminId        String?
  adminEmail     String
  action         String // admin.login | admin.login_failed | user.create | …
  targetType     String? // user | board | session | token | admin
  targetId       String?
  details        Json?
  createdAt      DateTime   @default(now())
  aggregateKey   String?    @unique
  eventCount     Int        @default(1)
  lastOccurredAt DateTime   @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([targetType, createdAt]) // target type + period
}

// ---------------------------------------------------------------------------
// Panel v3 (TASK-61…65): feature flags, operational singletons, announcements
// and editable mail templates.
// ---------------------------------------------------------------------------

// Feature flags (TASK-61) — one row per flag key, global switch plus an
// optional per-user override map (`{ "<userId>": true }`). The key IS the id.
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  perUser   Json?
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Operational singleton (TASK-61/63): nullable booleans mean "unset → the
// env default applies". `maintenanceMode` closes the user API; the rest are
// runtime overrides the panel can set without a redeploy.
model OpsSettings {
  id                         String   @id // always "singleton"
  registrationEnabled        Boolean?
  publicSharesEnabled        Boolean?
  maintenanceMode            Boolean  @default(false)
  maintenanceMessage         String?
  perUserRateLimit           Int?
  retentionDays              Int?
  // TASK-68: cadence of the maintenance sweeps in minutes; null = default,
  // 0 = disabled. Applied to the BullMQ Job Scheduler (or the fallback timer).
  maintenanceIntervalMinutes Int?
  // TASK-72: scheduled comms. Interval in hours; null/0 = disabled.
  digestIntervalHours        Int?
  reminderLeadHours          Int?
  updatedBy                  String?
  updatedAt                  DateTime @updatedAt
}

// Due-reminder dedupe (TASK-83). One row per (card, user, dueDate) we have
// already reminded about, so an overlapping/restarted scheduler never sends
// the same reminder twice. Keyed on `dueDate` too: rescheduling a card
// re-arms the reminder. Pruned by the maintenance sweep.
model ReminderSent {
  id      String   @id @default(cuid())
  cardId  String
  userId  String
  dueDate DateTime
  sentAt  DateTime @default(now())

  @@unique([cardId, userId, dueDate])
  @@index([sentAt])
  @@index([dueDate]) // reminder retention sweep (TASK-148)
}

// In-app attention inbox (TASK-166.9). One row per (event, recipient); the
// unique `dedupKey` is what makes retries, multiple open tabs and repeated
// maintenance sweeps idempotent. Deliberately relation-free like the other
// TASK-166 operational tables: recipients are re-checked against live board
// membership on read, and the retention sweep reclaims old rows without
// fighting the account/board purge. `boardId` is null for account-level
// events (the board quota).
model AttentionNotification {
  id              String    @id @default(cuid())
  userId          String
  boardId         String?
  type            String // approval.requested|approval.decided|approval.expired|agent.blocked|agent.needs_human|comment.mention|claim.expired|quota.exceeded
  // TASK-177.12: exact target for comment-scoped rows. A nullable column (no
  // FK) lets a comment tombstone/hard purge outlive its notification cleanup.
  commentId       String?
  dedupKey        String    @unique @db.VarChar(300)
  title           String    @db.VarChar(300)
  body            String?   @db.Text
  data            Json?
  readAt          DateTime?
  emailedAt       DateTime?
  digestedAt      DateTime?
  attentionMailId String?   @unique
  digestMailId    String?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, digestedAt])
  @@index([digestMailId])
  @@index([boardId, createdAt])
  @@index([commentId])
  @@index([createdAt]) // attention retention sweep
}

// In-app announcement / banner (TASK-62). `audience` "all" shows to every
// signed-in user; "segment" restricts to a CSV of user emails in `segment`.
model Announcement {
  id             String                    @id @default(cuid())
  // Legacy content: only rows created before the translations model carry
  // this. New rows keep their content exclusively in `translations`.
  title          String?
  body           String?                   @db.Text
  // Language of the original text. Null marks a legacy row whose language is
  // unknown: it is served as-is, without a fallback notice.
  sourceLocale   String?
  // require_all | allow_fallback. New rows default to the strict policy;
  // legacy rows were backfilled to allow_fallback by the migration.
  fallbackPolicy String                    @default("require_all")
  level          String                    @default("info") // info | warning | danger
  audience       String                    @default("all") // all | segment
  segment        String? // CSV of user emails when audience = segment
  active         Boolean                   @default(true)
  // TASK-62 broadcast: when true the letter is also queued to every
  // recipient's inbox through the durable broadcast outbox.
  sendEmail      Boolean                   @default(false)
  // When the localized delivery was staged; null = never staged.
  emailSentAt    DateTime?
  startsAt       DateTime?
  endsAt         DateTime?
  createdBy      String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  // Optimistic concurrency for the admin editor (convention §7.0): increments
  // on every PATCH; a stale version is answered with 409 instead of silently
  // overwriting another admin's translation.
  version        Int                       @default(1)
  translations   AnnouncementTranslation[]
  dismissals     AnnouncementDismissal[]

  @@index([active, startsAt, endsAt])
}

// One language version of a logical announcement (announcement localization).
// `sourceLocale` on the parent points at the original; every other row is a
// translation. `origin`/`reviewedAt`/`sourceUpdatedAt` leave room for the
// phase-2 AI draft workflow without another migration.
model AnnouncementTranslation {
  id              String       @id @default(cuid())
  announcementId  String
  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  locale          String // en | ru (string — headroom for a third language)
  title           String
  body            String       @db.Text
  origin          String       @default("human") // human | ai_draft | legacy
  translatedFrom  String?
  sourceUpdatedAt DateTime?
  reviewedAt      DateTime?
  updatedBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([announcementId, locale])
  @@index([locale])
}

// Per-user announcement dismissal. The banner is per-account and survives a
// new device/browser: the server returns only announcements this user has not
// dismissed at the current version. A PATCH bumps `Announcement.version`, so
// an edited announcement is shown again even to users who closed the old one.
model AnnouncementDismissal {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  version        Int
  dismissedAt    DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

// Editable mail template (TASK-62) — overrides the built-in template of the
// same key (the key IS the id). `{{code}}`, `{{name}}`, `{{url}}` placeholders
// are substituted at send time; the built-in body is the fallback.
model EmailTemplate {
  key       String   @id
  subject   String
  bodyHtml  String   @db.Text
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Durable notification mail. Redis carries only the id; PostgreSQL owns the
// payload, retry state and completion record.
enum NotificationMailKind {
  broadcast
  attention
  digest
  reminder
}

model NotificationMail {
  id            String               @id
  kind          NotificationMailKind
  message       Json?
  userId        String?
  boardIds      String[]             @default([])
  attempts      Int                  @default(0)
  nextAttemptAt DateTime             @default(now())
  finishedAt    DateTime?
  failedAt      DateTime?

  @@index([finishedAt, nextAttemptAt, id])
  @@index([userId])
}
