// Janosik schema — TASK-24 ships User + RefreshToken (auth); the full §7.3
// schema (Board/Column/Card/Command/...) lands with TASK-25.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  displayName   String?
  isSuperAdmin  Boolean  @default(false) // first registered user
  createdAt     DateTime @default(now())
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  revokedAt DateTime? // rotation; reuse of a revoked token revokes all user sessions
}
