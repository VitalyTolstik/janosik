// Janosik schema — full §7.3 (TASK-25): normalized kanban board, membership
// roles, soft-delete flags and per-entity versions from day one.
//
// Conventions (ROADMAP §7.0):
// - Every deletable entity carries `deletedAt` (soft-delete); cascades are
//   app-level flag propagation, never DB `onDelete: Cascade` (default
//   RESTRICT keeps referential integrity until the purge job runs).
// - Every entity holding editable text carries `version` for `ifMatch` → 409
//   undo-conflict handling: Board, Column, Card, Label, Checklist, ChecklistItem.
// - `@db.VarChar(N)` bounds mirror `LIMITS` from `@janosik/shared` (Prisma
//   cannot import TS constants — keep these numbers in sync manually).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  // Nullable (TASK-54): OAuth-only accounts have no local password — login
  // rejects them until one is adopted via the password change.
  passwordHash    String?
  displayName     String?
  avatarColor String? // USER_AVATAR_COLORS key (TASK-36.1); null → id-hash default
  avatarPath String? // TASK-47 stored avatar image name; null → initials
  disabledAt DateTime? // master block (TASK-36); login/refresh → 403
  emailVerifiedAt DateTime? // TASK-53; null → the address is not confirmed yet
  createdAt DateTime @default(now())
  memberships     BoardMember[]
  invitedMembers  BoardMember[] @relation("BoardMemberInviter")
  activity        Activity[]
  comments        Comment[]
  apiTokens       ApiToken[]
  commands        Command[]
  refreshTokens   RefreshToken[]
  attachments     Attachment[]
  assignedCards   Card[]        @relation("CardAssignee")
  emailChanges    EmailChangeCode[]
  verifications   EmailVerificationCode[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  revokedAt DateTime? // rotation; reuse of a revoked token revokes all user sessions
  createdAt DateTime  @default(now()) // session review page (TASK-43)

  @@index([userId, createdAt])
}

// Email change (TASK-51) — double opt-in: the user proves the current
// password, a 6-digit code goes to the NEW address and must be presented
// back before `User.email` moves. Mirrors the RefreshToken discipline: only
// the sha256 of the code is stored, one live row per user (a new request
// deletes the previous one), single-use, short TTL, and an attempts counter
// so a code cannot be brute-forced inside its lifetime.
model EmailSettings {
  // Singleton row (id is always "singleton") — the master-panel editable
  // mail transport (TASK-52). Overrides the SMTP_* env bootstrap at runtime.
  id          String    @id
  provider    String // gmail | yandex | mailru | brevo | sendgrid | custom | mailpit
  host        String
  port        Int
  secure      Boolean   @default(false)
  from        String
  username    String
  passwordEnc String? // AES-256-GCM (secret-box); never leaves the backend
  enabled     Boolean   @default(false)
  lastTestAt  DateTime?
  lastTestOk  Boolean?
  lastError   String?
  updatedBy   String?
  updatedAt   DateTime  @updatedAt
}

model EmailChangeCode {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  newEmail   String
  codeHash   String    @unique
  attempts   Int       @default(0) // wrong guesses; ≥ MAX → row deleted
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Registration email confirmation (TASK-53): the same discipline as the
// email-change codes — only the sha256 of the code is stored, one live row
// per user, single-use, short TTL, and an attempts counter so a code cannot
// be brute-forced inside its lifetime.
model EmailVerificationCode {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  codeHash   String    @unique
  attempts   Int       @default(0) // wrong guesses; ≥ MAX → row deleted
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// OAuth login (TASK-54) — one row per external provider (the id IS the
// provider id: "google" | "yandex"), editable from the master panel. The
// client secret is encrypted at rest with secret-box (AES-256-GCM) and
// never leaves the backend, like EmailSettings.passwordEnc.
model OAuthProviderSettings {
  id              String   @id
  clientId        String
  clientSecretEnc String? // AES-256-GCM (secret-box); never leaves the backend
  enabled         Boolean  @default(false)
  updatedBy       String?
  updatedAt       DateTime @updatedAt
}

model Board {
  id         String        @id @default(cuid())
  title      String        @db.VarChar(100) // LIMITS.boardTitle
  archivedAt DateTime?
  deletedAt  DateTime? // soft-delete (§7.0)
  version    Int           @default(0) // ifMatch → 409 (title editable)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  members    BoardMember[]
  columns    Column[]
  labels     Label[]
  cardLinks  CardLink[]
  activity   Activity[]
  commands   Command[]
}

model BoardMember {
  id          String    @id @default(cuid())
  board       Board     @relation(fields: [boardId], references: [id])
  boardId     String
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  role        Role      @default(MEMBER) // ADMIN | MEMBER | VIEWER
  expiresAt   DateTime? // VIEWER on a time budget; expired → 403
  // Opt-in invitations (TASK-35 addendum): the row is created as a pending
  // invitation and confers NO access until the invitee accepts. `null` =
  // pending; a timestamp = accepted at that moment.
  acceptedAt  DateTime?
  invitedBy   User?     @relation("BoardMemberInviter", fields: [invitedById], references: [id])
  invitedById String?
  createdAt   DateTime  @default(now())

  @@unique([boardId, userId])
  @@index([userId]) // "my boards"
  @@index([userId, acceptedAt]) // pending invitation feed
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

// Master tiers (TASK-36). OWNER manages masters from the panel; OPERATOR
// has full data access but cannot create or block masters, so a compromised
// operator session cannot escalate privileges or lock the owner out.
enum AdminRole {
  OWNER
  OPERATOR
}

model ApiToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  name       String // "CI", "integration …"
  tokenHash  String    @unique // shown once, only the hash is stored
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Command {
  id        String   @id // = client commandId → idempotent retries
  board     Board    @relation(fields: [boardId], references: [id])
  boardId   String
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  seq       BigInt   @default(autoincrement()) // monotonic board version; ?since=
  type      String // BoardAction type
  payload   Json // whole action (deterministic — TASK-21.7a)
  result    Json // first apply result {seq, versions}
  // Display snapshot captured when the command applied (TASK-37): the
  // history feed renders "from → to" diffs from here — the action alone
  // carries only the new values. Null for rows written before the column.
  details   Json?
  touches   String[] // ["card:c1","column:col-2"] — touched entities
  createdAt DateTime @default(now())

  @@index([boardId, seq])
  @@index([boardId, touches]) // activity feeds per entity (§7.4)
}

model Column {
  id        String    @id // client-provided id
  board     Board     @relation(fields: [boardId], references: [id])
  boardId   String
  title     String    @db.VarChar(100)
  wipLimit  Int? // TASK-13
  position  Int
  deletedAt DateTime? // soft-delete (§7.0)
  version   Int       @default(0) // ifMatch → 409 (§7.0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  cards     Card[]

  @@index([boardId, position])
}

model Card {
  id              String       @id
  column          Column       @relation(fields: [columnId], references: [id])
  columnId        String
  title           String       @db.VarChar(300) // LIMITS.cardTitle
  description     String?      @db.Text // markdown, LIMITS.description
  coverType       String? // color | gradient
  coverValue      String?
  dueDate         DateTime?
  priority        String? // TASK-45: blocker|highest|high|medium|low|lowest (null = medium)
  assigneeId      String? // TASK-49 Jira-style assignee; null = unassigned
  assignee        User?    @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  archivedAt      DateTime? // TASK-18.1: card archive
  deletedAt       DateTime? // soft-delete (§7.0)
  version         Int          @default(0) // ifMatch → 409 (§7.0)
  position        Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastActorId     String? // TASK-36 "who changed it" denormalization
  // TASK-47 denormalized live-attachment count (card-face badge); kept in
  // step by the attachments service, outside the command loop.
  attachmentCount Int          @default(0)
  labels          CardLabel[]
  checklists      Checklist[]
  linksFrom       CardLink[]   @relation("CardLinkFrom")
  linksTo         CardLink[]   @relation("CardLinkTo")
  activity        Activity[]
  comments        Comment[]
  attachments     Attachment[]

  @@index([columnId, position])
  @@index([assigneeId]) // admin user-detail "assigned cards" (TASK-49)
}

// Card links (TASK-46). Directional: `fromCard` holds the row and "blocks"
// (or "relates to" / "duplicates") `toCard`. Rows are immutable (no text to
// edit, hence no version) — undo/redo flip `deletedAt`, exactly like the
// client reducer adds/removes the row on the source card. Rows pointing at
// a soft-deleted card are kept: the aggregate skips them with the card, and
// restoring the card revives the link the way the client's undo does.
model CardLink {
  id         String    @id // client-provided link id
  board      Board     @relation(fields: [boardId], references: [id])
  boardId    String
  fromCard   Card      @relation("CardLinkFrom", fields: [fromCardId], references: [id])
  fromCardId String
  toCard     Card      @relation("CardLinkTo", fields: [toCardId], references: [id])
  toCardId   String
  type       String // blocks | relates_to | duplicates
  position   Int       @default(0) // order within the source card's `links`
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  // No `version` column on purpose: links are last-write-wins (§7.0) — the
  // only commands carrying `ifMatch` preconditions are text edits, and a
  // link row has no text. `Card.version` already covers the card it hangs on.

  @@index([boardId])
  @@index([fromCardId, position])
  @@index([toCardId])
}

model Label {
  id        String      @id
  board     Board       @relation(fields: [boardId], references: [id])
  boardId   String
  name      String      @db.VarChar(50) // LIMITS.labelName
  color     String // one of the 14 palette colors
  // Order in `board.labels` (TASK-27). §7.3 omitted it, but the aggregate
  // and the reducer both treat the label list as ordered (RESTORE_LABEL
  // carries an insertion `index`), so the order must be stored.
  position  Int         @default(0)
  deletedAt DateTime? // soft-delete (§7.0)
  version   Int         @default(0) // ifMatch → 409 (§7.0)
  cards     CardLabel[]

  @@index([boardId, position])
}

model CardLabel {
  card     Card   @relation(fields: [cardId], references: [id])
  cardId   String
  label    Label  @relation(fields: [labelId], references: [id])
  labelId  String
  position Int    @default(0)

  @@id([cardId, labelId])
  @@index([labelId]) // label cascade
}

model Checklist {
  id        String          @id
  card      Card            @relation(fields: [cardId], references: [id])
  cardId    String
  title     String          @db.VarChar(100)
  position  Int
  deletedAt DateTime? // soft-delete (§7.0)
  version   Int             @default(0) // ifMatch → 409 (title editable)
  items     ChecklistItem[]

  @@index([cardId, position])
}

model ChecklistItem {
  id          String    @id
  checklist   Checklist @relation(fields: [checklistId], references: [id])
  checklistId String
  text        String    @db.VarChar(200)
  done        Boolean   @default(false)
  position    Int
  deletedAt   DateTime? // soft-delete (§7.0)
  version     Int       @default(0) // ifMatch → 409 (text editable)

  @@index([checklistId, position])
}

// Boundary with the Command log (decided with variant B):
//   Command  — everything that is a `BoardAction` (column/card/label/checklist
//              create/edit/move/archive). Card activity events are derived
//              FROM it, nothing to duplicate here.
//   Activity — only what the reducer action is NOT and therefore cannot live
//              in Command (payload is typed as BoardAction): membership
//              (invite / role change / removal) and comments.
// Feed = merge of both sources by `createdAt` (composite cursor).
model Activity {
  id        String   @id @default(cuid())
  board     Board    @relation(fields: [boardId], references: [id])
  boardId   String
  card      Card?    @relation(fields: [cardId], references: [id])
  cardId    String?
  type      String // member_invited | member_role_changed | member_removed | comment_added
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String // now a real user
  details   Json? // snapshot details (email, role, …)
  createdAt DateTime @default(now())

  @@index([boardId, createdAt])
  @@index([cardId, createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  card      Card      @relation(fields: [cardId], references: [id])
  cardId    String
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String
  text      String    @db.Text // LIMITS.comment (10000) — plain text
  deletedAt DateTime? // soft-delete (§7.0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([cardId, createdAt])
}

// File attachments (TASK-47) — self-hosted blobs on the local disk under
// `UPLOAD_DIR`. Like comments, they live OUTSIDE the command loop (no undo,
// no board JSON), so rows are version-free and soft-deleted like comments.
// `storedName` is a server-generated name — the client's `fileName` is
// metadata only and must never be used as a filesystem path.
model Attachment {
  id           String    @id @default(cuid())
  card         Card      @relation(fields: [cardId], references: [id])
  cardId       String
  boardId      String
  fileName     String
  storedName   String    @unique
  mimeType     String
  sizeBytes    Int // ≤ LIMITS.attachmentSize (25 MB)
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  uploadedById String
  // Inline media (TASK-48 paste): embedded into a description/comment body
  // via its `content` URL instead of the attachment list — hidden from
  // `list()` and excluded from the card-face `attachmentCount`.
  isInline     Boolean   @default(false)
  // TASK-50 video "ужиматор": video uploads re-encode to a compact H.264
  // MP4 in a background job (original kept until the encode succeeds).
  // `none` — not a video (or transcode disabled), `pending` — queued/
  // running, `done` — `storedName` now points at the MP4, `failed` —
  // the original stays and plays as-is.
  transcodeStatus String  @default("none")
  deletedAt    DateTime? // soft-delete (§7.0)
  createdAt    DateTime  @default(now())

  @@index([cardId, createdAt])
}

// ---------------------------------------------------------------------------
// Platform operator — the "master account" (TASK-36).
//
// Deliberately NOT a `User`: it never appears in the public registration,
// never shows up in user listings and can never be a board member. The only
// way to create one is the `npm run admin:create` CLI on the server; the
// admin panel authenticates through its own JWT audience, its own cookie
// path and its own refresh-token table, so a stolen user session cannot
// reach a single `/admin` route and vice versa.
// ---------------------------------------------------------------------------
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  // Tier of this master (TASK-36): OWNER | OPERATOR — see `enum AdminRole`.
  role         AdminRole @default(OPERATOR)
  failedLogins Int       @default(0) // lockout counter
  lockedUntil  DateTime? // set after N consecutive failures
  disabledAt   DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  refreshTokens AdminRefreshToken[]
  auditLogs     AdminAuditLog[]
}

model AdminRefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 of the raw token, never the token
  admin     AdminUser @relation(fields: [adminId], references: [id])
  adminId   String
  expiresAt DateTime
  revokedAt DateTime? // rotation; reuse of a revoked token kills all sessions
  createdAt DateTime  @default(now())

  @@index([adminId])
}

// Accountability layer (§ admin panel best practices, TASK-36): every login
// attempt and every mutation lands here. `adminEmail` is a snapshot so the
// trail stays readable even for unknown-email login attempts.
model AdminAuditLog {
  id         String     @id @default(cuid())
  admin      AdminUser? @relation(fields: [adminId], references: [id])
  adminId    String?
  adminEmail String
  action     String // admin.login | admin.login_failed | user.create | …
  targetType String? // user | board | session | token | admin
  targetId   String?
  details    Json?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}
