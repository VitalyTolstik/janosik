node_modules/

# Build output
dist/
dist-ssr/
*.local

# TypeScript build info
*.tsbuildinfo

# Vitest
.vitest/
coverage/

# Pi session artifacts (13MB+ HTML logs)
pi-session-*.html

# Live probe screenshots (pw-smoke run from backend/)
backend/*.png

# Env / secrets
.env
.env.*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp
# Keep the env example (backend/.env.example)
!.env.example

# Self-hosted uploads (TASK-47)
backend/data/

# Playwright MCP browser artifacts
.playwright-mcp/

# Marketing site (Astro) — build output and assets generated from `brand/`
site/dist/
site/.astro/
site/public/favicon.svg
site/public/og.png
site/public/og-*.png

# Video workspace (Remotion) — assets copied from `brand/` at render time.
# The rendered clips in `site/public/media/` ARE committed (they are the
# landing page's assets), so they are not ignored here.
video/public/fonts/
video/public/logo.svg

# Recording pipeline — raw takes and the seed manifest are regenerated, only
# the encoded clips in `site/public/media/` are committed.
video/record/out/
video/record/.state.json
