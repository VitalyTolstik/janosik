# Never ship build output, dependencies or local state into the image.
**/node_modules
**/dist
**/coverage
**/.turbo

# Local environment and data.
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
data
backend/data
**/uploads

# Editor / OS / VCS noise.
.git
.github
**/.DS_Store
**/*.log
**/.playwright-mcp

# Docs and audits are not needed to build the image.
*.md
!README.md
ROADMAP*.md
REVIEW-TASKS.md
ALL_AUDIT.md
LAST_COMMIT_AUDIT.md
AGENT.md
docs
