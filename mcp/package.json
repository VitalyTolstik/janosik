{
  "name": "@janosik/mcp",
  "version": "0.1.0",
  "mcpName": "io.github.vitalytolstik/janosik",
  "description": "MCP server for Janosik — let AI agents drive a Kanban board through the command API.",
  "license": "AGPL-3.0-or-later",
  "author": "Vitali Toustsik",
  "homepage": "https://github.com/VitalyTolstik/janosik#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitalyTolstik/janosik.git",
    "directory": "mcp"
  },
  "bugs": "https://github.com/VitalyTolstik/janosik/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kanban",
    "agents",
    "janosik"
  ],
  "type": "module",
  "bin": {
    "janosik-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../.prettierignore"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@janosik/shared": "*",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.1"
  }
}
