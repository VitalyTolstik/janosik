{
  "name": "@janosik/e2e",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "playwright test",
    "test:docker": "bash run-docker.sh",
    "test:security": "E2E_PORT=${E2E_PORT:-4420} E2E_MAIL_PORT=${E2E_MAIL_PORT:-4920} bash run-docker.sh tests/security",
    "test:admin": "E2E_ADMIN_TEST=1 bash run-docker.sh tests/admin",
    "test:admin:global": "bash run-admin-global.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.4.1",
    "typescript": "~5.9.0"
  }
}
